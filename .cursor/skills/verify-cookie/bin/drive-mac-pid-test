    verb + " -SIGKILL " + quoted,
    verb + " -s SIGKILL " + quoted,
    verb + " -n 9 " + quoted,
    verb + " -HUP " + quoted,
    verb + " -INT " + quoted,
    verb + " -SIGTERM " + quoted,
    verb + " -- " + quoted,
    verb + " -9 -- " + quoted,
    verb + " -9 " + braced,
    verb + " -9 " + unbraced,
    verb + " -9 " + unquoted,
    verb + " -9 " + bare,
    verb + " -9 '" + unquoted + "'",
    "command " + verb + " -9 " + quoted,
    "builtin " + verb + " -9 " + quoted,
    "/bin/" + verb + " -9 " + quoted,
    "/usr/bin/" + verb + " -9 " + quoted,
    verb + "\t-9\t" + quoted,
    verb + "\t-SIGKILL\t" + unquoted,
    "command\t" + verb + "\t-9\t" + quoted,
    verb + "  -9   " + quoted,
    ev + ' "' + verb + " -9 " + unquoted + '"',
    ev + ' "' + verb + " -9 " + other + '"',
    pk + " -P",
    verb + "all CookieAgent",
    verb + " -s 0 " + quoted,
    verb + " -n 0 " + quoted,
    verb + " -0 -9 " + quoted,
    verb + " -- -0 " + quoted,
    verb + " -0 " + quoted + " || " + verb + " -9 " + quoted,
    xs + " " + verb,
    xs + " " + verb + " -9 " + quoted,
    "printf '%s\\n' " + quoted + " | " + xs + " -n1 " + verb,
    "k=" + verb,
    "KILL=" + verb,
    'k="' + verb + '"',
    "KILL='" + verb + "'",
    "k=/bin/" + verb,
    "k=/usr/bin/" + verb,
    "k=$'" + verb + "'",
    "readonly k=" + verb,
    "typeset k=" + verb,
    "alias k=" + verb,
    "local k=" + verb,
    "declare k=" + verb,
    "export k=" + verb,
    "local -r k=" + verb,
    "declare -r k=" + verb,
    "if true; then k=" + verb,
    "do k=" + verb,
    "else k=" + verb,
    "{ k=" + verb + "; }",
    "# do not " + verb + " APP_PID here\n" + verb + " -9 " + quoted,
]
# By design the check does not catch aliasing through another variable,
# ${!ref} or a nameref, the kill command held in a variable, a wrapper
# function, or xargs. The real protection is the pid re-check in
# signal_verified_app_pid and stop_pid. A line that contains xargs and
# kill, and an assignment of the bare word kill, are still flagged.
allowed = [
    verb + " -0 " + quoted,
    verb + " -0 " + unquoted,
    verb + " -0 " + braced,
    verb + " -0 " + unbraced,
    verb + " -0 " + bare,
    verb + " -0 -- " + quoted,
    "if ! " + verb + " -0 " + quoted + " 2>/dev/null",
    "command " + verb + " -0 " + quoted,
    "builtin " + verb + " -0 " + quoted,
    "/bin/" + verb + " -0 " + quoted,
    verb + "\t-0\t" + quoted,
    verb + " -9 " + other,
    verb + " -0 " + other,
    verb + " -SIGKILL " + other,
    verb + " -9 " + decoy,
    verb + " " + other,
    'p="$APP_PID"; ' + verb + " -9 " + '"$p"',
    ev + ' "echo ok"',
    xs + " echo ok",
    "k=" + verb + "er",
    "# do not " + verb + " APP_PID here",
    'log "mode k=' + verb + '"',
    "k=" + verb + ".sh",
    verb + "_count=" + verb,
]
inside_ok = (
    "signal_verified_app_pid() {\n  "
    + verb
    + " -9 "
    + quoted
    + "\n  "
    + verb
    + " -TERM "
    + quoted
    + "\n  "
    + verb
    + " -SIGKILL "
    + braced
    + "\n  "
    + verb
    + " -- "
    + unquoted
    + "\n}\nDECOY_DATA=\n"
)
inside_pk = "signal_verified_app_pid() {\n  " + pk + " -P\n}\nDECOY_DATA=\n"
inside_all = (
    "signal_verified_app_pid() {\n  " + verb + "all CookieAgent\n}\nDECOY_DATA=\n"
)
inside_ev = (
    "signal_verified_app_pid() {\n  "
    + ev
    + ' "'
    + verb
    + " -9 "
    + unquoted
    + '"\n}\nDECOY_DATA=\n'
)

leaked = signal_violations(text)
if leaked:
    sys.exit("APP_PID signal outside signal_verified_app_pid: " + " | ".join(leaked))
for sample in rejected:
    if not signal_violations(wrap(sample)):
        sys.exit("fixture was not caught: " + sample)
for sample in allowed:
    hit = signal_violations(wrap(sample))
    if hit:
        sys.exit("allowed fixture was flagged: " + sample + " | " + " | ".join(hit))
if signal_violations(inside_ok):
    sys.exit("a signal inside signal_verified_app_pid was flagged")
between_helper = (
    "signal_verified_app_pid() {\n  :\n}\n"
    "added_after() {\n"
    + verb
    + " -9 "
    + quoted
    + "\n}\nDECOY_DATA=\n"
)
if not signal_violations(between_helper):
    sys.exit("a function added after signal_verified_app_pid was exempt")
heredoc_apostrophe = (
    "signal_verified_app_pid() {\n"
    "  cat <<EOF\n"
    "don't\n"
    "EOF\n"
    "}\n"
    + verb
    + " -9 "
    + quoted
    + "\nDECOY_DATA=\n"
)
if not signal_violations(heredoc_apostrophe):
    sys.exit("heredoc apostrophe hid a " + verb + " after the helper")
heredoc_brace = (
    "signal_verified_app_pid() {\n"
    "  cat <<EOF\n"
    "}\n"
    "EOF\n"
    "}\n"
    "DECOY_DATA=\n"
)
brace_failed = False
try:
    signal_violations(heredoc_brace)
except SystemExit as exc:
    brace_failed = True
    message = exc.code if isinstance(exc.code, str) else str(exc.code)
    if "disagree" not in message:
        sys.exit("heredoc brace failed for the wrong reason: " + message)
if not brace_failed:
    sys.exit("a heredoc line `}` ended the helper region silently")
past_decoy = "signal_verified_app_pid() {\n  :\nDECOY_DATA=\n}\n"
past_failed = False
try:
    signal_violations(past_decoy)
except SystemExit as exc:
    past_failed = True
    message = exc.code if isinstance(exc.code, str) else str(exc.code)
    if "DECOY_DATA" not in message:
        sys.exit("region past DECOY_DATA failed for the wrong reason: " + message)
if not past_failed:
    sys.exit("a helper region past DECOY_DATA was accepted")
quote = "'"
skew = "$" + quote + "\\" + quote + quote
n87 = (
    "signal_verified_app_pid() {\n"
    "  echo {\n"
    "}  \n"
    + verb
    + " -9 "
    + quoted
    + "\n"
    "helper_g() {\n"
    "  echo }\n"
    "}\n"
    "DECOY_DATA=\n"
)
n88 = (
    "signal_verified_app_pid() {\n"
    "  local q="
    + skew
    + "\n"
    "}  \n"
    + verb
    + " -9 "
    + quoted
    + "\n"
    "helper_g() {\n"
    "  local q2="
    + skew
    + "\n"
    "}\n"
    "DECOY_DATA=\n"
)
n92 = (
    "signal_verified_app_pid() {\n"
    "  echo {\n"
    "} # end helper\n"
    + verb
    + " -9 "
    + quoted
    + "\n"
    "helper_g() {\n"
    "  echo }\n"
    "}\n"
    "DECOY_DATA=\n"
)
n91 = (
    "signal_verified_app_pid() {\n"
    "  echo {\n"
    "  :; }\n"
    + verb
    + " -9 "
    + quoted
    + "\n"
    "helper_g() {\n"
    "  echo }\n"
    "}\n"
    "DECOY_DATA=\n"
)
for name, sample in (("n-87", n87), ("n-88", n88), ("n-91", n91), ("n-92", n92)):
    if not caught(sample):
        sys.exit(name + " was not flagged")
here_string = (
    "signal_verified_app_pid() {\n"
    "  x=$(cat <<< \"don't\")\n"
    "}\n"
    + verb
    + " -9 "
    + quoted
    + "\nDECOY_DATA=\n"
)
if not signal_violations(here_string):
    sys.exit("here-string hid a " + verb + " after the helper")
for sample in (inside_pk, inside_all, inside_ev):
    if not signal_violations(sample):
        sys.exit("fixture inside signal_verified_app_pid was not caught: " + sample)
stopped = body("stop_verified_drive_pids", "\ntrap cleanup EXIT")
if '"$cohort"' not in stopped:
    sys.exit("stop_verified_drive_pids does not pass the cohort to verify")
if 'stop_verified_drive_pids "${fresh_pids[@]}"' not in opened:
    sys.exit("open-clean does not stop every fresh pid")
PY

