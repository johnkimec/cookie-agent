  set -euo pipefail
  nolsof="$(mktemp -d)"
  for cmd in awk python3 mktemp cat rm mv cp chmod grep sort tr sed; do
    src="$(command -v "$cmd" || true)"
    if [[ -n "$src" ]]; then
      ln -s "$src" "$nolsof/$cmd"
    fi
  done
  ln -s "$FIXTURE/bin/ps" "$nolsof/ps"
  PATH="$nolsof"
  export PATH
  if command -v lsof >/dev/null 2>&1; then
    printf 'lsof is still on PATH\n' >&2
    exit 1
  fi
