normalize_pids() {
  local line out=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if [[ -z "$out" ]]; then
      out="$line"
    else
      out="$out $line"
    fi
  done < <(printf '%s\n' "$1" | awk 'NF' | sort -n)
  printf '%s\n' "$out"
}

expect_owned_llama() {
  local label="$1" runtime="$2" chat="$3" embed="$4" want="$5" verdict="$6"
  local got err status norm count
  err="$(mktemp)"
  : >"$SIGNALED"
  status=0
  got="$(drive_owned_llama_pids 222 "$DRIVE_BIN" "$DRIVE_NAME" "$DRIVE_BUNDLE" "$DRIVE_DATA" "$chat" "$embed" 2>"$err")" || status=$?
  if [[ "$status" -ne 0 ]]; then
    printf '%s: owned pids failed: %s\n' "$label" "$(cat "$err")" >&2
    exit 1
  fi
  if [[ -s "$err" ]]; then
    printf '%s: owned pids wrote a reason: %s\n' "$label" "$(cat "$err")" >&2
    exit 1
  fi
  rm -f "$err"
  norm="$(normalize_pids "$got")"
  if [[ "$norm" != "$want" ]]; then
    printf '%s: owned [%s], want [%s]\n' "$label" "${norm:-empty}" "${want:-empty}" >&2
    exit 1
  fi
  count=0
  if [[ -n "$norm" ]]; then
    count="$(printf '%s\n' "$norm" | wc -w | tr -d ' ')"
  fi
  if [[ "$verdict" == "pass" ]]; then
    if ! orphan_reap_within_limit "$runtime" "$count"; then
      printf '%s: count %s should pass for %s\n' "$label" "$count" "$runtime" >&2
      exit 1
    fi
  else
    if orphan_reap_within_limit "$runtime" "$count"; then
      printf '%s: count %s should fail for %s\n' "$label" "$count" "$runtime" >&2
      exit 1
    fi
  fi
  if [[ -s "$SIGNALED" ]]; then
    printf '%s: a pid was signaled: %s\n' "$label" "$(cat "$SIGNALED")" >&2
    exit 1
  fi
}

expect_owned_closed() {
  local label="$1" pid="$2" name="$3" bundle="$4" needle="${5:-}"
  local got err status reason
  err="$(mktemp)"
  : >"$SIGNALED"
  status=0
  got="$(drive_owned_llama_pids "$pid" "$DRIVE_BIN" "$name" "$bundle" "$DRIVE_DATA" 18080 18081 2>"$err")" || status=$?
  reason="$(cat "$err")"
  rm -f "$err"
  if [[ "$status" -eq 0 ]]; then
    printf '%s: expected a closed failure\n' "$label" >&2
    exit 1
  fi
  if [[ -n "$(printf '%s' "$got" | tr -d '[:space:]')" ]]; then
    printf '%s: closed failure printed pids: %s\n' "$label" "$got" >&2
    exit 1
  fi
  if [[ -z "$reason" ]]; then
    printf '%s: closed failure had no reason\n' "$label" >&2
    exit 1
  fi
  if [[ -n "$needle" && "$reason" != *"$needle"* ]]; then
    printf '%s: reason [%s] does not contain %s\n' "$label" "$reason" "$needle" >&2
    exit 1
  fi
  if [[ -s "$SIGNALED" ]]; then
    printf '%s: closed failure signaled %s\n' "$label" "$(cat "$SIGNALED")" >&2
    exit 1
  fi
}

if ! orphan_reap_within_limit fake 0; then
  printf 'fake count 0 should pass\n' >&2
  exit 1
fi
if orphan_reap_within_limit fake 1; then
  printf 'fake count 1 should fail\n' >&2
  exit 1
fi
if ! orphan_reap_within_limit real 2; then
  printf 'real count 2 should pass\n' >&2
  exit 1
fi
if orphan_reap_within_limit real 3; then
  printf 'real count 3 should fail\n' >&2
  exit 1
fi

