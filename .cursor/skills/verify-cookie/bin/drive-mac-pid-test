#!/bin/bash
# Linux-side checks for drive-mac pid verification. No app and no AppleScript.
set -euo pipefail

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=drive-mac-pid.sh
source "$BIN_DIR/drive-mac-pid.sh"

FIXTURE="$(mktemp -d "${TMPDIR:-/tmp}/cookie-drive-pid.XXXXXX")"
trap 'rm -rf "$FIXTURE"' EXIT
mkdir -p "$FIXTURE/bin"
export FIXTURE

cat >"$FIXTURE/bin/ps" <<'EOF'
#!/bin/bash
# macOS prints the full executable path, including spaces in Cookie Agent.app.
if [[ "$*" == "-axww -o pid=,comm=" ]]; then
  awk -F '|' '{ print $1, $2 }' "$FIXTURE/procs"
  exit 0
fi
if [[ "$1" == "-ww" && "$2" == "-p" && "$4" == "-o" && "$5" == "comm=" ]]; then
  awk -F '|' -v pid="$3" '$1 == pid { print $2; exit }' "$FIXTURE/procs"
  exit 0
fi
printf 'unexpected ps %s\n' "$*" >&2
exit 1
EOF

cat >"$FIXTURE/bin/lsof" <<'EOF'
#!/bin/bash
pid=""
prev=""
for arg in "$@"; do
  if [[ "$prev" == "-p" ]]; then
    pid="$arg"
  fi
  prev="$arg"
done
awk -F '|' -v pid="$pid" '$1 == pid { n = split($3, paths, ";"); for (i = 1; i <= n; i++) print "n" paths[i] }' "$FIXTURE/procs"
EOF
chmod +x "$FIXTURE/bin/ps" "$FIXTURE/bin/lsof"

export PATH="$FIXTURE/bin:$PATH"

kill() {
  if [[ "${1:-}" == "-0" ]]; then
    awk -F '|' -v pid="$2" '$1 == pid { found = 1 } END { exit found ? 0 : 1 }' "$FIXTURE/procs"
    return
  fi
  return 0
}

write_procs() {
  printf '%s\n' "$@" >"$FIXTURE/procs"
}

JOHN="/Applications/Cookie Agent.app/Contents/MacOS/CookieAgent"
OURS="/tmp/dist/Cookie Agent.app/Contents/MacOS/CookieAgent"
DECOY="/tmp/cookie-drive-decoy/Cookie Agent.app/Contents/MacOS/CookieAgent"

expect_ok() {
  local pid="$1" bin="$2"
  local reason
  reason="$(verify_drive_pid_reason "$pid" "$bin" || true)"
  if [[ -n "$reason" ]]; then
    printf 'expected ok for %s %s: %s\n' "$pid" "$bin" "$reason" >&2
    exit 1
  fi
}

expect_fail() {
  local pid="$1" bin="$2" needle="$3"
  local reason
  reason="$(verify_drive_pid_reason "$pid" "$bin" || true)"
  if [[ -z "$reason" ]]; then
    printf 'expected failure for %s %s\n' "$pid" "$bin" >&2
    exit 1
  fi
  case "$reason" in
    *"$needle"*) ;;
    *)
      printf 'expected failure containing %s, got %s\n' "$needle" "$reason" >&2
      exit 1
      ;;
  esac
}

write_procs \
  "111|$JOHN|$JOHN" \
  "222|$OURS|$OURS" \
  "333|$DECOY|$DECOY"

expect_ok 222 "$OURS"
expect_ok 111 "$JOHN"
expect_ok 333 "$DECOY"
expect_fail 222 "$JOHN" "executable is not"
expect_fail 111 "$OURS" "executable is not"
expect_fail 999 "$OURS" "is not running"
expect_fail abc "$OURS" "not one integer"
expect_fail 1 "$OURS" "not a drive pid"
expect_fail "" "$OURS" "not one integer"

# A dylib listed before the executable still matches the bundle we launched.
write_procs \
  "222|$OURS|/usr/lib/dyld;$OURS"
expect_ok 222 "$OURS"

# Two processes at the same path are ambiguous.
write_procs \
  "222|$OURS|$OURS" \
  "444|$OURS|$OURS"
expect_fail 222 "$OURS" "also pid 444"
expect_fail 444 "$OURS" "also pid 222"

# John's process does not make our path ambiguous.
write_procs \
  "111|$JOHN|$JOHN" \
  "222|$OURS|$OURS"
expect_ok 222 "$OURS"

# macOS comm is the full path. The space in Cookie Agent.app must not hide it.
write_procs "111|/Applications/Cookie Agent.app/Contents/MacOS/CookieAgent|$JOHN"
spaced="$(comm_pids_named CookieAgent | tr -d '[:space:]')"
if [[ "$spaced" != "111" ]]; then
  printf 'spaced CookieAgent path was not found, got %s\n' "${spaced:-empty}" >&2
  exit 1
fi
if [[ "$(process_comm_name 111)" != "CookieAgent" ]]; then
  printf 'basename of spaced comm was %s\n' "$(process_comm_name 111)" >&2
  exit 1
fi
if [[ -n "$(comm_pids_named Cookie | tr -d '[:space:]')" ]]; then
  printf 'path component Cookie matched as the process name\n' >&2
  exit 1
fi
# A short comm value still matches, for a ps that does not print a path.
write_procs "555|CookieAgent|$JOHN"
short="$(comm_pids_named CookieAgent | tr -d '[:space:]')"
if [[ "$short" != "555" ]]; then
  printf 'short CookieAgent comm was not found, got %s\n' "${short:-empty}" >&2
  exit 1
fi

expect_identity_ok() {
  local pid="$1" bin="$2" name="$3" bundle="$4"
  local reason
  reason="$(verify_drive_pid_reason "$pid" "$bin" "$name" "$bundle" || true)"
  if [[ -n "$reason" ]]; then
    printf 'expected identity ok for %s %s: %s\n' "$pid" "$name" "$reason" >&2
    exit 1
  fi
}

expect_identity_fail() {
  local pid="$1" bin="$2" name="$3" bundle="$4" needle="$5"
  local reason
  reason="$(verify_drive_pid_reason "$pid" "$bin" "$name" "$bundle" || true)"
  if [[ -z "$reason" || "$reason" != *"$needle"* ]]; then
    printf 'expected identity failure containing %s, got %s\n' "$needle" "${reason:-ok}" >&2
    exit 1
  fi
}

expect_name_fail() {
  local pid="$1" bin="$2" name="$3" bundle="$4" needle="$5"
  local reason
  reason="$(verify_drive_identity_reason "$pid" "$bin" "$name" "$bundle" || true)"
  if [[ -z "$reason" || "$reason" != *"$needle"* ]]; then
    printf 'expected name failure containing %s, got %s\n' "$needle" "${reason:-ok}" >&2
    exit 1
  fi
}

write_bundle() {
  local root="$1" name="$2" bundle="$3"
  local exe_name="${4:-$name}"
  local bundle_value="${5:-$bundle}"
  mkdir -p "$root/Contents/MacOS"
  : >"$root/Contents/MacOS/$name"
  python3 - "$root/Contents/Info.plist" "$exe_name" "$bundle_value" <<'PY'
import plistlib
import sys

path, exe_name, bundle_value = sys.argv[1:]
with open(path, "wb") as handle:
    plistlib.dump(
        {
            "CFBundleExecutable": exe_name,
            "CFBundleIdentifier": bundle_value,
            "CFBundleName": "Cookie",
        },
        handle,
    )
PY
  printf '%s\n' "$root/Contents/MacOS/$name"
}

DRIVE_NAME="CDrvabcd1234"
DRIVE_BUNDLE="com.johnkimec.cookie-agent.drive.abcd1234"
DECOY_NAME="CDrv9999aaaa"
DECOY_BUNDLE="com.johnkimec.cookie-agent.drive.9999aaaa"
DRIVE_BIN="$(write_bundle "$FIXTURE/drive.app" "$DRIVE_NAME" "$DRIVE_BUNDLE")"
DECOY_BIN="$(write_bundle "$FIXTURE/decoy.app" "$DECOY_NAME" "$DECOY_BUNDLE")"

write_procs \
  "111|$JOHN|$JOHN" \
  "222|$DRIVE_BIN|$DRIVE_BIN" \
  "333|$DECOY_BIN|$DECOY_BIN"
expect_identity_ok 222 "$DRIVE_BIN" "$DRIVE_NAME" "$DRIVE_BUNDLE"
expect_identity_ok 333 "$DECOY_BIN" "$DECOY_NAME" "$DECOY_BUNDLE"
expect_identity_fail 222 "$DRIVE_BIN" "$DRIVE_NAME" "com.johnkimec.cookie-agent" "installed app"
expect_identity_fail 222 "$DRIVE_BIN" "$DRIVE_NAME" "com.johnkimec.cookie-agent.drive" "not a per-run drive bundle id"
expect_identity_fail 111 "$DRIVE_BIN" "$DRIVE_NAME" "$DRIVE_BUNDLE" "executable is not"

write_procs "222|/tmp/other/CookieAgent|$DRIVE_BIN"
expect_name_fail 222 "$DRIVE_BIN" "$DRIVE_NAME" "$DRIVE_BUNDLE" "process name is CookieAgent"
expect_identity_fail 222 "$DRIVE_BIN" "CookieAgent" "$DRIVE_BUNDLE" "product executable"
expect_identity_fail 222 "$DRIVE_BIN" "$DRIVE_NAME" "$DRIVE_BUNDLE" "expected exactly one"

MISMATCH="$(write_bundle "$FIXTURE/mismatch.app" "$DRIVE_NAME" "$DRIVE_BUNDLE" "CookieAgent" "$DRIVE_BUNDLE")"
write_procs "222|$MISMATCH|$MISMATCH"
expect_identity_fail 222 "$MISMATCH" "$DRIVE_NAME" "$DRIVE_BUNDLE" "CFBundleExecutable"

BUNDLE_MISMATCH="$(write_bundle "$FIXTURE/bundle-mismatch.app" "$DRIVE_NAME" "$DRIVE_BUNDLE" "$DRIVE_NAME" "com.johnkimec.cookie-agent")"
write_procs "222|$BUNDLE_MISMATCH|$BUNDLE_MISMATCH"
expect_identity_fail 222 "$BUNDLE_MISMATCH" "$DRIVE_NAME" "$DRIVE_BUNDLE" "bundle id is"

expect_menu() {
  local expect="$1"
  local line="$2"
  local opened=0
  if status_menu_open "$line"; then
    opened=1
  fi
  if [[ "$expect" == "open" && "$opened" -ne 1 ]]; then
    printf 'expected menu open, got closed: %s\n' "$line" >&2
    exit 1
  fi
  if [[ "$expect" == "closed" && "$opened" -ne 0 ]]; then
    printf 'expected menu closed, got open: %s\n' "$line" >&2
    exit 1
  fi
}

# pid, AXSelected, exposed item count, position, size, window count.
# The item count is accepted and dropped. It must not appear on the line.
facts_line() {
  local items="$3"
  : "$items"
  printf '%s\t%s\t%s\t%s\t%s' "$1" "$2" "$4" "$5" "$6"
}

# Sergey's self-check line: AXSelected no, the old item-count signal yes, windows 0.
expect_menu closed $'19527\tno\tyes\t0'
# Closed menu with items exposed. No on-screen position.
expect_menu closed "$(facts_line 19527 no 4 - - 0)"
# AXSelected opens the menu even when nothing is on screen.
expect_menu open "$(facts_line 19527 yes 0 - - 0)"
# Status-item menu with an on-screen position and a positive size.
expect_menu open "$(facts_line 19527 no 4 120,28 180,200 1)"
# A closed menu can still report a size at the placeholder origin.
expect_menu closed "$(facts_line 19527 no 4 0,0 180,200 0)"
expect_menu closed "$(facts_line 19527 no 4 120,28 0,90 1)"
# Some other window of this pid is not the status menu.
expect_menu closed "$(facts_line 19527 no 4 - - 2)"
expect_menu closed "$(facts_line 19527 no 4 10,-4 180,200 1)"

if [[ "$(drive_temp_data_dir /tmp/cookie-m0.Ab12Cd)" != "/tmp/cookie-m0.Ab12Cd" ]]; then
  printf 'drive data dir was not recognized\n' >&2
  exit 1
fi
if [[ -n "$(drive_temp_data_dir /tmp/cookie-m0-decoy.Ab12Cd)" ]]; then
  printf 'decoy data dir was treated as the drive data dir\n' >&2
  exit 1
fi
if [[ -n "$(drive_temp_data_dir /tmp/cookie-m0.Ab12Cd/nested)" ]]; then
  printf 'nested data path was accepted\n' >&2
  exit 1
fi
if [[ -n "$(drive_temp_data_dir /tmp/not-cookie)" ]]; then
  printf 'unrelated temp dir was accepted\n' >&2
  exit 1
fi
if [[ -n "$(drive_temp_data_dir "$HOME/Library/Application Support/com.johnkimec.cookie-agent")" ]]; then
  printf 'Application Support was accepted for deletion\n' >&2
  exit 1
fi

observe="$(awk '
  /^observe_status\(\)/ { capture = 1 }
  capture { print }
  capture && /^}$/ { exit }
' "$BIN_DIR/drive-mac")"
case "$observe" in
  *'menu items'*)
    printf 'observe_status still decides from menu items\n' >&2
    exit 1
    ;;
esac
case "$observe" in
  *AXSelected*) ;;
  *)
    printf 'observe_status does not read AXSelected\n' >&2
    exit 1
    ;;
esac
case "$observe" in
  *'position of statusMenu'*) ;;
  *)
    printf 'observe_status does not read the status menu position\n' >&2
    exit 1
    ;;
esac
case "$observe" in
  *'size of statusMenu'*) ;;
  *)
    printf 'observe_status does not read the status menu size\n' >&2
    exit 1
    ;;
esac

# Isolation refusals. This does not launch the app. Linux CI runs this file
# from lint-drive-mac-targeting. Exit 4 is the refusal. 3 is the open-clean skip.
cat >"$FIXTURE/bin/open" <<'EOF'
#!/bin/bash
printf '%s\n' "$*" >"$FIXTURE/launched"
exit 99
EOF
chmod +x "$FIXTURE/bin/open"

if [[ "$ISOLATION_REFUSAL_CODE" -eq 0 || "$ISOLATION_REFUSAL_CODE" -eq 3 ]]; then
  printf 'isolation exit code must not be 0 or 3\n' >&2
  exit 1
fi
if [[ "$ISOLATION_REFUSAL_CODE" -ne 4 ]]; then
  printf 'isolation exit code is %s, want 4\n' "$ISOLATION_REFUSAL_CODE" >&2
  exit 1
fi

expect_refuse() {
  local label="$1" home="$2" data="$3" real="$4" needle="$5"
  local err code
  code=0
  err="$(HOME="$home" COOKIE_DATA_DIR="$data" REAL_HOME="$real" assert_isolated_data_dir 2>&1)" || code=$?
  if [[ "$code" -eq 0 || "$code" -eq 3 ]]; then
    printf 'isolation %s exited %s\n' "$label" "$code" >&2
    exit 1
  fi
  if [[ "$code" -ne 4 ]]; then
    printf 'isolation %s exited %s, want 4: %s\n' "$label" "$code" "$err" >&2
    exit 1
  fi
  case "$err" in
    *"refusing to launch"*) ;;
    *)
      printf 'isolation %s missing refusal: %s\n' "$label" "$err" >&2
      exit 1
      ;;
  esac
  case "$err" in
    *"$needle"*) ;;
    *)
      printf 'isolation %s missing %s: %s\n' "$label" "$needle" "$err" >&2
      exit 1
      ;;
  esac
  if [[ -f "$FIXTURE/launched" ]]; then
    printf 'isolation %s launched the app\n' "$label" >&2
    exit 1
  fi
}

expect_allow() {
  local label="$1" home="$2" data="$3" real="$4"
  local err code
  code=0
  err="$(HOME="$home" COOKIE_DATA_DIR="$data" REAL_HOME="$real" assert_isolated_data_dir 2>&1)" || code=$?
  if [[ "$code" -ne 0 ]]; then
    printf 'isolation %s exited %s: %s\n' "$label" "$code" "$err" >&2
    exit 1
  fi
  if [[ -n "$err" ]]; then
    printf 'isolation %s printed %s\n' "$label" "$err" >&2
    exit 1
  fi
  if [[ -f "$FIXTURE/launched" ]]; then
    printf 'isolation %s launched the app\n' "$label" >&2
    exit 1
  fi
}

ISO="$(mktemp -d "$FIXTURE/iso.XXXXXX")"
REAL="$ISO/RealHome"
DATA="$REAL/Library/Application Support/com.johnkimec.cookie-agent"
mkdir -p "$DATA/nested"
SAFE_HOME="$(mktemp -d "$FIXTURE/safe-home.XXXXXX")"
SAFE_DATA="$(mktemp -d "$FIXTURE/safe-data.XXXXXX")"
ln -s "$DATA/nested" "$FIXTURE/into-data"
ln -s "$REAL" "$FIXTURE/home-link"
mkdir -p "$REAL/Library/Application Support/com.johnkimec.cookie-agent-extra"

expect_refuse "data-dir" "$SAFE_HOME" "$DATA" "$REAL" "COOKIE_DATA_DIR is the real cookie data directory"
# launch_verified keeps a non-empty caller COOKIE_DATA_DIR and still asserts it.
# A caller-supplied real data directory is refused before the binary starts.
caller_data="$DATA"
if [[ -z "$caller_data" ]]; then
  printf 'caller data dir fixture was empty\n' >&2
  exit 1
fi
launch_data="$caller_data"
expect_refuse "caller-supplied-data-dir" "$SAFE_HOME" "$launch_data" "$REAL" "COOKIE_DATA_DIR is the real cookie data directory"
expect_refuse "subdir" "$SAFE_HOME" "$DATA/nested" "$REAL" "COOKIE_DATA_DIR is the real cookie data directory"
expect_refuse "mixed-case" "$SAFE_HOME" "$REAL/library/APPLICATION SUPPORT/com.johnkimec.COOKIE-AGENT" "$REAL" "COOKIE_DATA_DIR is the real cookie data directory"
expect_refuse "symlink" "$SAFE_HOME" "$FIXTURE/into-data" "$REAL" "COOKIE_DATA_DIR is the real cookie data directory"
expect_refuse "home" "$REAL" "$SAFE_DATA" "$REAL" "HOME is the real home"
expect_refuse "home-mixed" "$ISO/realhome" "$SAFE_DATA" "$REAL" "HOME is the real home"
expect_refuse "home-symlink" "$FIXTURE/home-link" "$SAFE_DATA" "$REAL" "HOME is the real home"
expect_refuse "home-inside-data" "$DATA/nested" "$SAFE_DATA" "$REAL" "HOME is the real cookie data directory"
expect_refuse "empty-data" "$SAFE_HOME" "" "$REAL" "COOKIE_DATA_DIR is empty"
expect_allow "temp" "$SAFE_HOME" "$SAFE_DATA" "$REAL"
expect_allow "sibling" "$SAFE_HOME" "$REAL/Library/Application Support/com.johnkimec.cookie-agent-extra" "$REAL"

account_home="$(directory_service_home)"
expect_refuse "account-home" "$account_home" "$SAFE_DATA" "" "HOME is the real home"
expect_allow "overridden-home" "$SAFE_HOME" "$SAFE_DATA" ""

ISOLATE_ROOT=""
ensure_isolate_root
isolate_dir home
iso_home="$ISOLATE_LAST"
isolate_dir data
iso_data="$ISOLATE_LAST"
if [[ ! -d "$iso_home" || ! -d "$iso_data" ]]; then
  printf 'isolate directories were not created\n' >&2
  exit 1
fi
if [[ "$iso_home" != "$ISOLATE_ROOT/"* || "$iso_data" != "$ISOLATE_ROOT/"* ]]; then
  printf 'isolate directories escaped %s (%s %s)\n' "$ISOLATE_ROOT" "$iso_home" "$iso_data" >&2
  exit 1
fi
if [[ "$(real_path "$ISOLATE_ROOT")" != "$ISOLATE_ROOT" ]]; then
  printf 'isolate root was not realpath'\''d: %s\n' "$ISOLATE_ROOT" >&2
  exit 1
fi
expect_allow "isolate-dirs" "$iso_home" "$iso_data" "$REAL"
iso_root="$ISOLATE_ROOT"
remove_isolate_root "$iso_root"
if [[ -d "$iso_root" || -d "$iso_home" || -d "$iso_data" ]]; then
  printf 'isolate cleanup left %s\n' "$iso_root" >&2
  exit 1
fi
remove_isolate_root "$REAL"
if [[ ! -d "$REAL" ]]; then
  printf 'isolate cleanup removed the real home\n' >&2
  exit 1
fi
remove_isolate_root "$DATA"
if [[ ! -d "$DATA" ]]; then
  printf 'isolate cleanup removed the real data directory\n' >&2
  exit 1
fi
ISOLATE_ROOT=""

python3 - "$BIN_DIR/drive-mac" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()


def body(name, end_marker):
    start = text.index(name + "() {")
    end = text.index(end_marker, start)
    return text[start:end]


launch = body("launch_verified", "\nlaunch_direct()")
if launch.index("assert_isolated_data_dir") > launch.index('"$bin" &'):
    sys.exit("assert_isolated_data_dir is after the direct launch")
if "HOME=" not in launch.split('"$bin" &', 1)[0]:
    sys.exit("direct launch does not set HOME before the binary")
nonempty = 'if [[ -n "${COOKIE_DATA_DIR:-}" ]]; then'
if nonempty not in launch:
    sys.exit("launch_verified lost the non-empty COOKIE_DATA_DIR branch")
then_part, after_then = launch.split(nonempty, 1)[1].split("else", 1)
if 'launch_data="$COOKIE_DATA_DIR"' not in then_part:
    sys.exit("non-empty COOKIE_DATA_DIR is not the launch data directory")
else_part, after_fi = after_then.split("fi", 1)
assert_line = 'assert_isolated_data_dir "$launch_home" "$launch_data"'
if assert_line in else_part:
    sys.exit("assert_isolated_data_dir is only reachable from the empty COOKIE_DATA_DIR branch")
if assert_line not in after_fi:
    sys.exit("assert_isolated_data_dir does not run when COOKIE_DATA_DIR is non-empty")
if after_fi.index(assert_line) > after_fi.index('"$bin" &'):
    sys.exit("a non-empty COOKIE_DATA_DIR launches before assert_isolated_data_dir")

opened = body("open_clean_check", "\nopen_clean_status=0")
if opened.index("assert_isolated_data_dir") > opened.index("/usr/bin/open -n"):
    sys.exit("assert_isolated_data_dir is after open -n")
env = opened.split("env -i", 1)[1].split("/usr/bin/open -n", 1)[0]
for needle in ('HOME="$isolate_home"', 'COOKIE_DATA_DIR="$isolate_data"'):
    if needle not in env:
        sys.exit("open-clean launch env missing " + needle)
if 'HOME="$HOME"' in text:
    sys.exit("a launch still passes the real HOME through")
if "assert_isolated_data_dir" not in launch or "assert_isolated_data_dir" not in opened:
    sys.exit("a launch path skipped assert_isolated_data_dir")
if "$(isolate_dir" in text:
    sys.exit("isolate_dir is inside a command substitution, so cleanup would miss the temp dir")
PY

printf '%s\n' "isolation self-test ok"
printf '%s\n' "drive-mac pid test ok"
