rm -f "$FIXTURE/lsof.good"

# Stale pid file: log closed and port changed, but the recorded pid is still
# llama-server. A reused pid that is not llama-server is not counted.
printf '%s\n' 930 >"$DRIVE_DATA/logs/llama-server.pid"
printf '%s\n' 50 >"$DRIVE_DATA/logs/llama-embed.pid"
write_procs \
  "111|$JOHN|$JOHN|1|$JOHN" \
  "222|$DRIVE_BIN|$DRIVE_BIN|1|$DRIVE_BIN" \
  "50|/usr/sbin/unrelated|/usr/sbin/unrelated|1|/usr/sbin/unrelated" \
  "900|$LLAMA|$LLAMA;$JOHN_LOG|111|$JOHN_CMD" \
  "930|$LLAMA|$LLAMA|1|$LLAMA --host 127.0.0.1 --port 9999"
expect_owned_llama "stale-pidfile" fake 18080 18081 "930" fail
rm -f "$DRIVE_DATA/logs/llama-server.pid" "$DRIVE_DATA/logs/llama-embed.pid"

# N1: SIGTERM lands, the pid stays alive, then it is reused by John's
# CookieAgent before the SIGKILL. The escalation is not sent.
sleep() { :; }
sleep 0
N1_PHASE=0
kill() {
  if [[ "${1:-}" == "-0" ]]; then
    if [[ "$N1_PHASE" == 1 ]]; then
      write_procs "222|$JOHN|$JOHN"
      N1_PHASE=2
    fi
    awk -F '|' -v pid="$2" '$1 == pid { found = 1 } END { exit found ? 0 : 1 }' "$FIXTURE/procs"
    return
  fi
  local target="${1:-}"
  if [[ "$target" == -* ]]; then
    target="${2:-}"
  fi
  if [[ "${1:-}" == "-9" ]]; then
    printf 'KILL %s\n' "$target" >>"$SIGNALED"
    return 0
  fi
  printf 'TERM %s\n' "$target" >>"$SIGNALED"
  N1_PHASE=1
  return 0
}
write_procs "222|$DRIVE_BIN|$DRIVE_BIN"
: >"$SIGNALED"
N1_PHASE=0
stop_pid 222 "$DRIVE_BIN" "$DRIVE_PROCESS_NAME" "$DRIVE_BUNDLE_ID"
if grep -q '^KILL ' "$SIGNALED"; then
  printf 'SIGKILL was sent after the pid was reused: %s\n' "$(cat "$SIGNALED")" >&2
  exit 1
fi
if ! grep -qx 'TERM 222' "$SIGNALED"; then
  printf 'SIGTERM did not reach the drive pid before reuse: %s\n' "$(cat "$SIGNALED")" >&2
  exit 1
fi
unset -f sleep

printf '%s\n' "isolation self-test ok"
printf '%s\n' "drive-mac pid test ok"
