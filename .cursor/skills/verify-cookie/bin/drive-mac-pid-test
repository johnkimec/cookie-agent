python3 - "$BIN_DIR/drive-mac" <<'PY'
import pathlib
import sys

text = pathlib.Path(sys.argv[1]).read_text()


def body(name, end_marker):
    start = text.index(name + "() {")
    end = text.index(end_marker, start)
    return text[start:end]


launch = body("launch_verified", "\nlaunch_direct()")
if launch.index("assert_isolated_data_dir") > launch.index('"$bin" &'):
    sys.exit("assert_isolated_data_dir is after the direct launch")
if "HOME=" not in launch.split('"$bin" &', 1)[0]:
