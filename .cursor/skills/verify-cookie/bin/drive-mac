relaunch_app() {
  local attempt gone=0
  for attempt in $(seq 1 40); do
    if [[ -z "$(pids_for_executable "$BIN" "$DRIVE_PROCESS_NAME" | tr -d '[:space:]')" ]]; then
      gone=1
      break
    fi
    sleep 0.25
  done
  if [[ "$gone" != "1" ]]; then
    fail "previous drive executable still running, refusing to launch another"
  fi
  launch_direct
  if ! wait_for_menu; then
    fail "menu bar did not return after relaunch"
  fi
  if [[ "$runtime" == "real" ]]; then
    if ! wait_for_runtime_up; then
      fail "runtime did not return after relaunch"
    fi
  fi
}

# kill -9 skips applicationShouldTerminate, so a server we launched is
# orphaned until the next launch reaps it. Fake mode has no llama-server.
# Real mode runs the chat server and the embedding server, so two processes
# is the ceiling.
orphan_reap_check() {
  local old_pid old_embed count limit
  old_pid="$(pid_file_pid || true)"
  old_embed=""
  if [[ "$runtime" == "real" ]]; then
    old_embed="$(pid_in_file "$COOKIE_DATA_DIR/logs/llama-embed.pid" || true)"
  fi
  log "orphan-reap signal 9 ${APP_PID} pidfile=${old_pid:-none} embed=${old_embed:-none}"
  kill -9 "$APP_PID" 2>/dev/null || true
  wait "$APP_PID" 2>/dev/null || true
  APP_PID=""
  sleep 0.5
  relaunch_app
  count="$(llama_server_count)"
  if [[ "$runtime" == "real" ]]; then
    limit=2
  else
    limit=1
  fi
  log "orphan-reap llama-server count ${count}"
  if [[ "$count" -gt "$limit" ]]; then
    fail "orphan reap left ${count} llama-server processes: $(llama_server_pids | tr '\n' ' ')"
  fi
  if [[ "$runtime" == "fake" && "$count" != "0" ]]; then
    fail "fake runtime has llama-server after relaunch"
  fi
  if [[ -n "$old_pid" ]] && pid_is_llama "$old_pid"; then
    if [[ "$runtime" != "real" && "$count" != "1" ]]; then
      fail "old llama-server ${old_pid} still alive with ${count} servers"
    fi
    log "orphan-reap reused ${old_pid}"
  else
    log "orphan-reap old server gone"
  fi
  if [[ -n "$old_embed" ]] && pid_is_llama "$old_embed"; then
    log "orphan-reap reused embed ${old_embed}"
  fi
  if [[ "$runtime" == "real" ]]; then
    assert_both_servers
  fi
}

orphan_reap_check

owned_before_quit="$(pid_file_pid || true)"
owned_embed_before=""
embed_port_now="$EMBED_PORT"
if [[ "$runtime" == "real" ]]; then
  owned_embed_before="$(pid_in_file "$COOKIE_DATA_DIR/logs/llama-embed.pid" || true)"
fi
log "quit via menu pid=${owned_before_quit:-none} embed=${owned_embed_before:-none} port=${PORT}"
