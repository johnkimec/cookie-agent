#!/bin/bash
# Mac recipe for the menu bar and the hotkey popup.
# Status stays planned until a Mac run writes verify-evidence/.
# On Linux this is the same reachability stub as drive-core.
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%s\n' "verified-unreachable on Linux: requires macOS"
  exit 2
fi

usage() {
  echo "usage: drive-mac [menu-bar-icon|hotkey-popup|chat|all|self-check|menu-local-only|menu-option-click|menu-thinking|popup-hotkey|popup-escape|popup-click-outside|popup-option-click|popup-input|popup-draft|popup-layout|chat-popup-reply|chat-talking-pose|status-loading|status-down|status-offline-chat|status-local-only] [--runtime fake|real] [--evidence dir]" >&2
  exit 2
}

feature="all"
runtime="fake"
evidence=""
focused=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    menu-bar-icon|hotkey-popup|chat|all|self-check)
      feature="$1"
      ;;
    menu-local-only|menu-option-click|menu-thinking|popup-hotkey|popup-escape|popup-click-outside|popup-option-click|popup-input|popup-draft|popup-layout|chat-popup-reply|chat-talking-pose|status-loading|status-down|status-offline-chat|status-local-only)
      feature="$1"
      focused=1
      ;;
    --runtime)
      [[ $# -ge 2 ]] || usage
      runtime="$2"
      shift
      if [[ "$runtime" != "fake" && "$runtime" != "real" ]]; then
        usage
      fi
      ;;
    --evidence)
      [[ $# -ge 2 ]] || usage
      evidence="$2"
      shift
      ;;
    *)
      usage
      ;;
  esac
  shift
done

if [[ "$focused" == "1" && -z "$evidence" ]]; then
  usage
fi

port="${COOKIE_LLAMA_PORT:-}"
data="${COOKIE_DATA_DIR:-}"
if [[ "$runtime" == "fake" && "$port" != "18080" ]]; then
  printf '%s\n' "not-ok" "COOKIE_LLAMA_PORT must be 18080"
  exit 1
fi
embed_given="${COOKIE_EMBED_PORT:-}"
if [[ "$runtime" == "fake" && -n "$embed_given" && "$embed_given" != "18081" ]]; then
  printf '%s\n' "not-ok" "COOKIE_EMBED_PORT must be 18081"
  exit 1
fi
if [[ -z "$data" || "$data" == *"Application Support"* ]]; then
  printf '%s\n' "not-ok" "COOKIE_DATA_DIR must be a fresh temp directory, not Application Support"
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
DRIVE_BIN_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=drive-mac-pid.sh
source "$DRIVE_BIN_DIR/drive-mac-pid.sh"
DRIVE_PROCESS_LIB="$DRIVE_BIN_DIR/cookie-drive-process.applescript"
APP="${COOKIE_APP:-"$ROOT/dist/Cookie Agent.app"}"
BIN="$APP/Contents/MacOS/CookieAgent"
if [[ ! -x "$BIN" ]]; then
  printf '%s\n' "not-ok" "set COOKIE_APP to Cookie Agent.app (missing $BIN)"
  exit 1
fi
SOURCE_APP="$APP"
SOURCE_BIN="$BIN"

export COOKIE_DATA_DIR="$data"
export COOKIE_CORE_CWD="${COOKIE_CORE_CWD:-$ROOT}"
if [[ "$runtime" == "real" ]]; then
  unset COOKIE_CORE_COMMAND
else
  export COOKIE_LLAMA_PORT=18080
  export COOKIE_EMBED_PORT=18081
  export COOKIE_CORE_COMMAND="${COOKIE_CORE_COMMAND:-pnpm --filter @cookie-agent/core fake-core}"
fi

log() { printf '%s\n' "$*"; }

APP_PID=""
DECOY_PID=""
DECOY_BIN=""
DECOY_PROCESS_NAME=""
DECOY_BUNDLE_ID=""
DRIVE_APP_ROOTS=""
TARGET_PID=""
TARGET_BIN=""
stop_pid() {
  local pid="$1"
  local expected_bin="${2:-}"
  local expected_name="${3:-}"
  local expected_bundle="${4:-}"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  [[ "$pid" -ge 2 ]] || return 0
  if [[ "$pid" == "$$" ]]; then
    return 0
  fi
  if [[ -z "$expected_bin" || -z "$expected_name" || -z "$expected_bundle" ]]; then
    log "not signaling pid $pid: identity was not recorded"
    return 0
  fi
  local reason
  reason="$(verify_drive_pid_reason "$pid" "$expected_bin" "$expected_name" "$expected_bundle" || true)"
  if [[ -n "$reason" ]]; then
    log "not signaling pid $pid: $reason"
    return 0
  fi
  if kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    local attempt
    for attempt in $(seq 1 40); do
      kill -0 "$pid" 2>/dev/null || break
      sleep 0.5
    done
    if kill -0 "$pid" 2>/dev/null; then
      kill -9 "$pid" 2>/dev/null || true
    fi
    wait "$pid" 2>/dev/null || true
  fi
}
DECOY_DATA=""
DRIVE_DATA=""
STUB_PID=""
pid_is_fault_stub() {
  local pid="$1"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  pid_alive "$pid" || return 1
  ps -p "$pid" -o command= 2>/dev/null | grep -E 'llama-fault-stub|llama-fault-wrapper' >/dev/null
}

stop_stub_pid() {
  local pid="$1"
  [[ -n "$pid" ]] || return 0
  if ! pid_is_fault_stub "$pid"; then
    return 0
  fi
  kill "$pid" 2>/dev/null || true
  local attempt
  for attempt in $(seq 1 20); do
    pid_alive "$pid" || return 0
    sleep 0.2
  done
  if pid_is_fault_stub "$pid"; then
    kill -9 "$pid" 2>/dev/null || true
  fi
}

cleanup() {
  local root fault
  stop_pid "$APP_PID" "$BIN" "${DRIVE_PROCESS_NAME:-}" "${DRIVE_BUNDLE_ID:-}"
  stop_pid "$DECOY_PID" "$DECOY_BIN" "$DECOY_PROCESS_NAME" "$DECOY_BUNDLE_ID"
  stop_stub_pid "${STUB_PID:-}" || true
  STUB_PID=""
  if declare -F pid_file_pid >/dev/null; then
    fault="$(pid_file_pid || true)"
    stop_stub_pid "$fault" || true
  fi
  while IFS= read -r root; do
    [[ -n "$root" ]] || continue
    case "$root" in
      */cookie-drive-app.*)
        rm -rf "$root"
        ;;
    esac
  done <<< "$DRIVE_APP_ROOTS"
  case "$DECOY_DATA" in
    /tmp/cookie-m0-decoy.*)
      rm -rf "$DECOY_DATA"
      ;;
  esac
  if [[ -n "$DRIVE_DATA" && "$(drive_temp_data_dir "$DRIVE_DATA")" == "$DRIVE_DATA" ]]; then
    rm -rf "$DRIVE_DATA"
  fi
}
trap cleanup EXIT

# Every System Events call goes through here. The process must be the pid
# this drive launched, and that pid's name and bundle id must be the per-run
# identity. The product executable name and bundle id are refused.
osascript_run() {
  local target_pid target_bin target_name target_bundle reason tmp code
  target_pid="${TARGET_PID:-$APP_PID}"
  target_bin="${TARGET_BIN:-$BIN}"
  target_name="${TARGET_PROCESS_NAME:-$DRIVE_PROCESS_NAME}"
  target_bundle="${TARGET_BUNDLE_ID:-$DRIVE_BUNDLE_ID}"
  if [[ -z "$target_name" || "$target_name" == "CookieAgent" ]]; then
    fail "refusing to drive: process identity is missing or is the product executable name"
  fi
  if [[ -z "$target_bundle" || "$target_bundle" == "com.johnkimec.cookie-agent" ]]; then
    fail "refusing to drive: bundle id is missing or is the installed app"
  fi
  reason="$(verify_drive_pid_reason "$target_pid" "$target_bin" "$target_name" "$target_bundle" || true)"
  if [[ -n "$reason" ]]; then
    fail "refusing to drive: $reason"
  fi
  tmp="$(mktemp "${TMPDIR:-/tmp}/cookie-drive-osa.XXXXXX")"
  if [[ "${1:-}" == "-e" ]]; then
    [[ $# -ge 2 ]] || fail "osascript_run is missing its script"
    printf '%s\n' "$2" >"$tmp.in"
    shift 2
  elif [[ $# -gt 0 && -f "${1:-}" ]]; then
    cp "$1" "$tmp.in"
    shift
  else
    cat >"$tmp.in"
  fi
  python3 "$DRIVE_BIN_DIR/prepend-drive-library.py" "$DRIVE_PROCESS_LIB" "$tmp.in" "$tmp"
  # Build the forbidden phrases so this file does not contain them literally.
  local named_tell='tell process '
  named_tell="${named_tell}\""
  local named_app='tell '
  named_app="${named_app}application "
  named_app="${named_app}\"Cookie"
  local quit_by_name='quit '
  quit_by_name="${quit_by_name}app"
  if grep -n -F "$named_tell" "$tmp" >/dev/null; then
    grep -n -F "$named_tell" "$tmp" >&2 || true
    rm -f "$tmp" "$tmp.in"
    fail "refusing to run AppleScript that targets a process by name"
  fi
  if grep -n -F "$named_app" "$tmp" >/dev/null; then
    rm -f "$tmp" "$tmp.in"
    fail "refusing to run AppleScript that tells Cookie by name"
  fi
  if grep -n -F "$quit_by_name" "$tmp" >/dev/null; then
    rm -f "$tmp" "$tmp.in"
    fail "refusing to run AppleScript that quits an app by name"
  fi
  set +e
  COOKIE_DRIVE_PID="$target_pid" COOKIE_DRIVE_PROCESS_NAME="$target_name" COOKIE_DRIVE_BUNDLE_ID="$target_bundle" /usr/bin/osascript "$tmp" "$@"
  code=$?
  set -e
  rm -f "$tmp" "$tmp.in"
  return "$code"
}

current_target_pid() {
  printf '%s\n' "${TARGET_PID:-$APP_PID}"
}

launch_verified() {
  # $1 binary, $2 app|decoy, $3 per-run process name, $4 per-run bundle id.
  local bin="$1" which="$2" name="$3" bundle="$4" existing attempt reason pid
  existing="$(pids_for_executable "$bin" "$name" | tr '\n' ' ')"
  if [[ -n "${existing// /}" ]]; then
    fail "refusing to launch: $bin already running as pid ${existing}"
  fi
  if [[ "$focused" == "1" && -n "${evidence:-}" ]]; then
    "$bin" >>"$evidence/app-stdout.txt" 2>>"$evidence/app-stderr.txt" &
  else
    "$bin" &
  fi
  pid=$!
  reason=""
  for attempt in $(seq 1 30); do
    reason="$(verify_drive_pid_reason "$pid" "$bin" "$name" "$bundle" || true)"
    if [[ -z "$reason" ]]; then
      remember_launched "$which" "$pid" "$bin" "$name" "$bundle"
      log "drive pid=$pid process=$name bundle=$bundle exe=$bin"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      break
    fi
    case "$reason" in
      *"also pid"*)
        fail "refusing to drive: $reason"
        ;;
    esac
    sleep 0.1
  done
  remember_launched "$which" "$pid" "$bin" "$name" "$bundle"
  fail "refusing to drive: ${reason:-pid $pid did not become $bin}"
}

remember_launched() {
  local which="$1" pid="$2" bin="$3" name="$4" bundle="$5"
  if [[ "$which" == "decoy" ]]; then
    DECOY_PID="$pid"
    DECOY_BIN="$bin"
    DECOY_PROCESS_NAME="$name"
    DECOY_BUNDLE_ID="$bundle"
  else
    APP_PID="$pid"
  fi
}

launch_direct() {
  launch_verified "$BIN" app "$DRIVE_PROCESS_NAME" "$DRIVE_BUNDLE_ID"
}

# Copy the packaged app to a per-run bundle. The executable name and bundle
# id are unique, so John's installed CookieAgent cannot share either one.
# CFBundleName stays Cookie. The product app on disk is not modified.
prepare_drive_bundle() {
  local source_app="$1"
  local source_bin="$source_app/Contents/MacOS/CookieAgent"
  [[ -x "$source_bin" ]] || fail "refusing to launch: $source_bin is not executable"
  local token name bundle_id root dest mac_dir
  token="$(python3 -c 'import secrets; print(secrets.token_hex(4))')"
  name="CDrv${token}"
  bundle_id="com.johnkimec.cookie-agent.drive.${token}"
  root="$(mktemp -d "${TMPDIR:-/tmp}/cookie-drive-app.XXXXXX")"
  DRIVE_APP_ROOTS="${DRIVE_APP_ROOTS}${root}"$'\n'
  dest="$root/${name}.app"
  if command -v ditto >/dev/null 2>&1; then
    ditto "$source_app" "$dest"
  else
    cp -R "$source_app" "$dest"
  fi
  mac_dir="$dest/Contents/MacOS"
  mv "$mac_dir/CookieAgent" "$mac_dir/$name"
  chmod +x "$mac_dir/$name"
  plutil -replace CFBundleExecutable -string "$name" "$dest/Contents/Info.plist"
  plutil -replace CFBundleIdentifier -string "$bundle_id" "$dest/Contents/Info.plist"
  codesign --force --sign - "$dest"
  local got_name got_bundle got_display
  got_name="$(plist_value "$dest/Contents/Info.plist" CFBundleExecutable || true)"
  got_bundle="$(plist_value "$dest/Contents/Info.plist" CFBundleIdentifier || true)"
  got_display="$(plist_value "$dest/Contents/Info.plist" CFBundleName || true)"
  if [[ "$got_name" != "$name" || "$got_bundle" != "$bundle_id" ]]; then
    fail "refusing to launch: prepared bundle identity did not stick (process ${got_name:-missing}, bundle ${got_bundle:-missing})"
  fi
  if [[ "$got_display" != "Cookie" ]]; then
    fail "refusing to launch: prepared bundle changed the visible name"
  fi
  PREPARED_APP="$dest"
  PREPARED_BIN="$mac_dir/$name"
  PREPARED_PROCESS_NAME="$name"
  PREPARED_BUNDLE_ID="$bundle_id"
}

install_prepared_identity() {
  prepare_drive_bundle "$1"
  APP="$PREPARED_APP"
  BIN="$PREPARED_BIN"
  DRIVE_PROCESS_NAME="$PREPARED_PROCESS_NAME"
  DRIVE_BUNDLE_ID="$PREPARED_BUNDLE_ID"
  log "drive identity process=$DRIVE_PROCESS_NAME bundle=$DRIVE_BUNDLE_ID app=$APP"
}

with_target() {
  local pid="$1" bin="$2" name="$3" bundle="$4"
  shift 4
  local saved_pid="${TARGET_PID:-}" saved_bin="${TARGET_BIN:-}"
  local saved_name="${TARGET_PROCESS_NAME:-}" saved_bundle="${TARGET_BUNDLE_ID:-}"
  local code=0
  TARGET_PID="$pid"
  TARGET_BIN="$bin"
  TARGET_PROCESS_NAME="$name"
  TARGET_BUNDLE_ID="$bundle"
  "$@" || code=$?
  TARGET_PID="$saved_pid"
  TARGET_BIN="$saved_bin"
  TARGET_PROCESS_NAME="$saved_name"
  TARGET_BUNDLE_ID="$saved_bundle"
  return "$code"
}

frontmost_unix_id() {
  osascript_run -e 'tell application "System Events" to unix id of first process whose frontmost is true'
}

trim_osascript() {
  printf '%s' "$1" | tr -d '[:space:]'
}

# Key codes go to the frontmost process. Refuse unless that unix id is ours.
send_key_code() {
  local code="$1"
  local modifier="${2:-}"
  [[ "$code" =~ ^[0-9]+$ ]] || fail "refusing keystroke: code is not an integer"
  if [[ -n "$modifier" && "$modifier" != "option" ]]; then
    fail "refusing keystroke: modifier is not option"
  fi
  COOKIE_KEY_CODE="$code" COOKIE_KEY_OPTION="$modifier" osascript_run <<'APPLESCRIPT'
set drivePid to (system attribute "COOKIE_DRIVE_PID") as integer
set keyCode to (system attribute "COOKIE_KEY_CODE") as integer
set expectedName to system attribute "COOKIE_DRIVE_PROCESS_NAME"
set expectedBundle to system attribute "COOKIE_DRIVE_BUNDLE_ID"
tell application "System Events"
  set frontProc to first process whose frontmost is true
  set frontPid to unix id of frontProc
  if frontPid is not drivePid then error "refusing keystroke: frontmost unix id " & frontPid & " is not drive pid " & drivePid
  if name of frontProc is not expectedName then error "refusing keystroke: frontmost process is not the launched executable"
  if bundle identifier of frontProc is not expectedBundle then error "refusing keystroke: frontmost bundle id is not the launched app"
  set mods to {}
  if (system attribute "COOKIE_KEY_OPTION") is "option" then set end of mods to option down
  key code keyCode using mods
end tell
APPLESCRIPT
}

fail() {
  log "not-ok"
  printf '%s\n' "$*" >&2
  exit 1
}

resolved_port() {
  if [[ "$runtime" == "fake" ]]; then
    printf '%s\n' "18080"
    return
  fi
  if [[ -z "${COOKIE_LLAMA_PORT:-}" ]]; then
    printf '%s\n' "8080"
  else
    printf '%s\n' "$COOKIE_LLAMA_PORT"
  fi
}

resolved_embed_port() {
  if [[ "$runtime" == "fake" ]]; then
    printf '%s\n' "18081"
    return
  fi
  if [[ -z "${COOKIE_EMBED_PORT:-}" ]]; then
    printf '%s\n' "8081"
  else
    printf '%s\n' "$COOKIE_EMBED_PORT"
  fi
}

PORT="$(resolved_port)"
EMBED_PORT="$(resolved_embed_port)"

port_listening() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

PORT_BEFORE=0
if port_listening "$PORT"; then
  PORT_BEFORE=1
fi

llama_server_pids() {
  ps -ax -o pid=,command= | awk '
    /llama-server/ && $0 !~ /awk/ && $0 !~ /drive-mac/ { print $1 }
  '
}

llama_server_count() {
  llama_server_pids | wc -l | tr -d ' '
}

pid_file_pid() {
  local file="$COOKIE_DATA_DIR/logs/llama-server.pid"
  [[ -f "$file" ]] || return 0
  awk 'NF >= 1 { print $1; exit }' "$file"
}

pid_in_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk 'NF >= 1 { print $1; exit }' "$file"
}

health_ok() {
  python3 - "$1" <<'PY'
import sys
import urllib.request
port = sys.argv[1]
url = "http://127.0.0.1:%s/health" % port
try:
    with urllib.request.urlopen(url, timeout=2) as response:
        raise SystemExit(0 if 200 <= response.status < 300 else 1)
except Exception:
    raise SystemExit(1)
PY
}

wait_health() {
  local port="$1" attempt
  for attempt in $(seq 1 40); do
    if health_ok "$port"; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# Real runtime only. Chat port and embed port both answer /health, and both
# pid files exist. Fake mode returns without checking.
assert_both_servers() {
  [[ "$runtime" == "real" ]] || return 0
  local chat_port="${1:-$PORT}"
  local embed_port="${2:-$EMBED_PORT}"
  local dir="${3:-$COOKIE_DATA_DIR}"
  local chat_pid embed_owned
  if ! wait_health "$chat_port"; then
    fail "chat /health not ok on ${chat_port}"
  fi
  if ! wait_health "$embed_port"; then
    fail "embed /health not ok on ${embed_port}"
  fi
  chat_pid="$(pid_in_file "$dir/logs/llama-server.pid" || true)"
  embed_owned="$(pid_in_file "$dir/logs/llama-embed.pid" || true)"
  if [[ -z "$chat_pid" || -z "$embed_owned" ]]; then
    fail "pid files missing in ${dir} chat=${chat_pid:-none} embed=${embed_owned:-none}"
  fi
  log "both servers health ok chat pid=${chat_pid} port=${chat_port} embed pid=${embed_owned} port=${embed_port}"
}

pid_alive() {
  local pid="$1"
  [[ -n "$pid" ]] || return 1
  kill -0 "$pid" 2>/dev/null
}

pid_is_llama() {
  local pid="$1"
  pid_alive "$pid" || return 1
  ps -p "$pid" -o command= | awk '/llama-server/ { found=1 } END { exit found ? 0 : 1 }'
}

# cwd of a core child (pnpm or node), not llama-server. Bash 3.2: no associative arrays.
core_child_cwd() {
  local app_pid="$1"
  local queue="$app_pid"
  local seen=" $app_pid "
  while [[ -n "$queue" ]]; do
    local current="${queue%% *}"
    if [[ "$queue" == "$current" ]]; then
      queue=""
    else
      queue="${queue#* }"
    fi
    local children child
    children="$(pgrep -P "$current" 2>/dev/null || true)"
    for child in $children; do
      case "$seen" in
        *" $child "*) continue ;;
      esac
      seen="$seen$child "
      if [[ -z "$queue" ]]; then
        queue="$child"
      else
        queue="$queue $child"
      fi
      local cmd cwd
      cmd="$(ps -p "$child" -o command= 2>/dev/null || true)"
      case "$cmd" in
        *llama-server*) continue ;;
      esac
      case "$cmd" in
        *pnpm*|*@cookie-agent/core*|*fake-core.ts*|*src/index.ts*)
          cwd="$(lsof -a -p "$child" -d cwd -Fn 2>/dev/null | awk '/^n/ { sub(/^n/, ""); print; exit }' || true)"
          if [[ -n "$cwd" ]]; then
            printf '%s\n' "$cwd"
            return 0
          fi
          ;;
      esac
    done
  done
  return 1
}

open_support_dir() {
  printf '%s\n' "$HOME/Library/Application Support/com.johnkimec.cookie-agent"
}

# Resolve the process by the pid and per-run identity this drive launched.
# Reading frontmost from inside that process tell is error -1728, so ask
# System Events outside it.
read_menu() {
  osascript_run <<'APPLESCRIPT'
set cookieProc to my cookieDriveProcess()
tell application "System Events"
  tell cookieProc
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    set itemLabel to description of statusItem
    click statusItem
    delay 0.4
    set names to name of menu items of menu 1 of statusItem
    click statusItem
  end tell
  set frontApp to name of first process whose frontmost is true
  return itemLabel & linefeed & (names as string) & linefeed & "frontmost " & frontApp
end tell
APPLESCRIPT
}

frontmost_app() {
  osascript_run -e 'tell application "System Events" to get name of first process whose frontmost is true'
}

# Primary open path. Synthetic ⌥Space and option-click are not this path.
open_via_ask() {
  osascript_run <<'APPLESCRIPT'
set cookieProc to my cookieDriveProcess()
tell application "System Events"
  tell cookieProc
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    click statusItem
    delay 0.4
    set itemCount to 0
    try
      set itemCount to count of menu items of menu 1 of statusItem
    end try
    if itemCount is 0 then
      click statusItem
      delay 0.4
    end if
    click menu item "Ask Cookie…" of menu 1 of statusItem
  end tell
end tell
APPLESCRIPT
}

# One line per identified element: identifier, role, value. Never coerce
# `entire contents` to a string (error -1700).
# A handler is compiled outside the caller's tell. `attribute` is only a
# System Events term, so axid and axtext tell System Events themselves.
dump_popup_ax() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

on coerceToString(rawValue)
  if rawValue is missing value then return ""
  set oldDelims to AppleScript's text item delimiters
  try
    if class of rawValue is list then
      set AppleScript's text item delimiters to " "
      set joined to rawValue as string
      set AppleScript's text item delimiters to oldDelims
      return joined
    end if
    set AppleScript's text item delimiters to oldDelims
    return rawValue as string
  on error
    set AppleScript's text item delimiters to oldDelims
    return ""
  end try
end coerceToString

on axtext(elem)
  set rawValue to missing value
  tell application "System Events"
    try
      set rawValue to value of elem
    end try
  end tell
  return my coerceToString(rawValue)
end axtext

set cookieProc to my cookieDriveProcess()
tell application "System Events"
  tell cookieProc
    set popupWindow to missing value
    repeat with candidate in windows
      set candidateName to ""
      set candidateSubrole to ""
      try
        set candidateName to name of candidate
      end try
      try
        set candidateSubrole to subrole of candidate as text
      end try
      if candidateName is "Ask Cookie…" or candidateSubrole is "AXSystemDialog" then
        set popupWindow to candidate
      end if
    end repeat
    if popupWindow is missing value then error "no Ask Cookie window"
    set nodes to entire contents of popupWindow
    set linesOut to {}
    set windowId to my axid(popupWindow)
    if windowId is not "" then set end of linesOut to windowId & tab & "AXWindow" & tab & ""
    repeat with elem in nodes
      set theId to my axid(elem)
      if theId is not "" then
        set theRole to ""
        try
          set theRole to role of elem as text
        end try
        set theValue to my axtext(elem)
        set end of linesOut to theId & tab & theRole & tab & theValue
      end if
    end repeat
    if linesOut is {} then error "popup exposed no AXIdentifier"
    set oldDelims to AppleScript's text item delimiters
    set AppleScript's text item delimiters to linefeed
    set output to linesOut as text
    set AppleScript's text item delimiters to oldDelims
    return output
  end tell
end tell
APPLESCRIPT
}

require_input_id() {
  python3 - <<'PY'
import pathlib, sys
from collections import Counter
text = pathlib.Path("/tmp/cookie-drive-mac-ax.txt").read_text()
ids = [line.split("\t", 1)[0] for line in text.splitlines() if line.strip()]
if "cookie.popup.input" not in ids:
    print("missing cookie.popup.input")
    print(text)
    sys.exit(1)
dupes = sorted(identifier for identifier, count in Counter(ids).items() if count > 1)
if dupes:
    print("duplicate AX identifiers: " + ", ".join(dupes))
    print(text)
    sys.exit(1)
print("popup identifiers ok")
PY
}

# Set the field through AX. System Events keystrokes go to the frontmost
# app, not this non-activating panel. AXConfirm is the field's Return.
send_chat() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

set cookieProc to my cookieDriveProcess()
tell application "System Events"
  tell cookieProc
    set popupWindow to missing value
    repeat with candidate in windows
      set candidateName to ""
      try
        set candidateName to name of candidate
      end try
      if candidateName is "Ask Cookie…" then set popupWindow to candidate
    end repeat
    if popupWindow is missing value then
      repeat with candidate in windows
        try
          if subrole of candidate as text is "AXSystemDialog" then set popupWindow to candidate
        end try
      end repeat
    end if
    if popupWindow is missing value then error "no Ask Cookie window"
    set nodes to entire contents of popupWindow
    set inputElem to missing value
    set sendElem to missing value
    repeat with elem in nodes
      set theId to my axid(elem)
      set theRole to ""
      try
        set theRole to role of elem as text
      end try
      if theId is "cookie.popup.input" then
        if theRole is "AXTextArea" or theRole is "AXTextField" or inputElem is missing value then
          set inputElem to elem
        end if
      end if
      if theId is "cookie.popup.send" then set sendElem to elem
    end repeat
    if inputElem is missing value then error "missing cookie.popup.input"
    set value of inputElem to "hello from drive-mac"
    delay 0.2
    set confirmed to false
    try
      perform action "AXConfirm" of inputElem
      set confirmed to true
    end try
    if confirmed is false then
      if sendElem is missing value then error "cannot confirm cookie.popup.input"
      click sendElem
    end if
  end tell
end tell
APPLESCRIPT
}

cookie_turn_value() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

on coerceToString(rawValue)
  if rawValue is missing value then return ""
  set oldDelims to AppleScript's text item delimiters
  try
    if class of rawValue is list then
      set AppleScript's text item delimiters to " "
      set joined to rawValue as string
      set AppleScript's text item delimiters to oldDelims
      return joined
    end if
    set AppleScript's text item delimiters to oldDelims
    return rawValue as string
  on error
    set AppleScript's text item delimiters to oldDelims
    return ""
  end try
end coerceToString

on axtext(elem)
  set rawValue to missing value
  set rawName to missing value
  set rawDescription to missing value
  tell application "System Events"
    try
      set rawValue to value of elem
    end try
    try
      set rawName to name of elem
    end try
    try
      set rawDescription to description of elem
    end try
  end tell
  set fromValue to my coerceToString(rawValue)
  if fromValue is not "" and fromValue is not "cookie" then return fromValue
  set fromName to my coerceToString(rawName)
  if fromName is not "" and fromName is not "cookie" then return fromName
  set fromDescription to my coerceToString(rawDescription)
  if fromDescription is not "" and fromDescription is not "cookie" then return fromDescription
  return ""
end axtext

set cookieProc to my cookieDriveProcess()
tell application "System Events"
  tell cookieProc
    set popupWindow to missing value
    repeat with candidate in windows
      try
        if name of candidate is "Ask Cookie…" then set popupWindow to candidate
      end try
    end repeat
    if popupWindow is missing value then
      repeat with candidate in windows
        try
          if subrole of candidate as text is "AXSystemDialog" then set popupWindow to candidate
        end try
      end repeat
    end if
    if popupWindow is missing value then return "missing-window"
    set nodes to entire contents of popupWindow
    repeat with elem in nodes
      set theId to my axid(elem)
      if theId is "cookie.turn.cookie.0" or theId is "cookie.turn.cookie.1" then
        set theValue to my axtext(elem)
        if theValue is not "" and theValue is not "cookie" then
          return theId & tab & theValue
        end if
      end if
    end repeat
    return "waiting"
  end tell
end tell
APPLESCRIPT
}

close_popup() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

try
  set cookieProc to my cookieDriveProcess()
on error
  return
end try
tell application "System Events"
  tell cookieProc
    repeat with candidate in windows
      try
        if name of candidate is not "Ask Cookie…" then
          -- keep looking
        else
          set nodes to entire contents of candidate
          repeat with elem in nodes
            if my axid(elem) is "cookie.popup.input" then
              try
                perform action "AXCancel" of elem
                return
              end try
            end if
          end repeat
        end if
      end try
    end repeat
  end tell
end tell
APPLESCRIPT
}

popup_is_open() {
  osascript_run <<'APPLESCRIPT'
try
  set cookieProc to my cookieDriveProcess()
on error
  return "no"
end try
tell application "System Events"
  tell cookieProc
    repeat with candidate in windows
      try
        if name of candidate is "Ask Cookie…" then return "yes"
      end try
    end repeat
  end tell
end tell
return "no"
APPLESCRIPT
}

option_click_status() {
  osascript_run "$DRIVE_BIN_DIR/scripts/option-click.applescript"
}

wait_for_menu() {
  local attempt
  for attempt in $(seq 1 30); do
    if read_menu > /tmp/cookie-drive-mac-menu.txt 2>/tmp/cookie-drive-mac-menu.err; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

wait_for_runtime_up() {
  local attempt
  for attempt in $(seq 1 120); do
    if read_menu > /tmp/cookie-drive-mac-menu.txt 2>/tmp/cookie-drive-mac-menu.err; then
      if python3 - <<'PY'
import pathlib, sys
text = pathlib.Path("/tmp/cookie-drive-mac-menu.txt").read_text()
if "fake-local" in text or "starting model" in text or "model offline" in text:
    sys.exit(1)
required = ["Ask Cookie…", "Local-only mode", "Quit Cookie", "🐾 Cookie · on-device · "]
missing = [item for item in required if item not in text]
if missing:
    sys.exit(1)
sys.exit(0)
PY
      then
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

# One line: pid, AXSelected, menu position, menu size, window count.
# Open is AXSelected, or menu 1 of this status item with an on-screen position
# and a positive size. Item count is not read: a closed menu still exposes them.
observe_status() {
  osascript_run <<'APPLESCRIPT'
set cookieProc to my cookieDriveProcess()
set selectedText to "no"
set menuPosText to "-"
set menuSizeText to "-"
set windowCount to 0
set drivePid to 0
tell application "System Events"
  tell cookieProc
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    try
      set rawSelected to value of attribute "AXSelected" of statusItem
      if rawSelected is true or rawSelected is 1 then set my selectedText to "yes"
    end try
    try
      set statusMenu to menu 1 of statusItem
      set menuPos to position of statusMenu
      set menuSize to size of statusMenu
      set my menuPosText to ((item 1 of menuPos) as integer) & "," & ((item 2 of menuPos) as integer)
      set my menuSizeText to ((item 1 of menuSize) as integer) & "," & ((item 2 of menuSize) as integer)
    end try
    try
      set my windowCount to count of windows
    end try
  end tell
  set my drivePid to unix id of cookieProc
end tell
return (drivePid as string) & (character id 9) & selectedText & (character id 9) & menuPosText & (character id 9) & menuSizeText & (character id 9) & (windowCount as string)
APPLESCRIPT
}

click_status() {
  osascript_run <<'APPLESCRIPT'
set cookieProc to my cookieDriveProcess()
set drivePid to 0
tell application "System Events"
  tell cookieProc
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    click statusItem
  end tell
  set my drivePid to unix id of cookieProc
end tell
return drivePid as string
APPLESCRIPT
}

wait_observe() {
  local pid="$1" bin="$2" name="$3" bundle="$4"
  local attempt line got
  for attempt in $(seq 1 40); do
    line="$(with_target "$pid" "$bin" "$name" "$bundle" observe_status 2>/dev/null || true)"
    got="$(status_field "$line" 1)"
    if [[ "$got" == "$pid" ]]; then
      printf '%s\n' "$line"
      return 0
    fi
    sleep 0.5
  done
  printf '%s\n' "$line"
  return 1
}

# Two per-run copies. Click only the drive pid. John's CookieAgent is observed, never signaled.
run_self_check() {
  # Global so the EXIT trap can delete it. A local would hide it from cleanup.
  DRIVE_DATA="$(drive_temp_data_dir "$COOKIE_DATA_DIR")"
  if [[ "$runtime" != "fake" ]]; then
    fail "self-check is fake-core only"
  fi
  prepare_drive_bundle "$SOURCE_APP"
  local decoy_app="$PREPARED_APP" decoy_bin="$PREPARED_BIN"
  local decoy_name="$PREPARED_PROCESS_NAME" decoy_bundle="$PREPARED_BUNDLE_ID"
  install_prepared_identity "$SOURCE_APP"
  if [[ "$DRIVE_PROCESS_NAME" == "$decoy_name" || "$DRIVE_BUNDLE_ID" == "$decoy_bundle" ]]; then
    fail "self-check identities collided"
  fi
  if [[ "$DRIVE_PROCESS_NAME" == "CookieAgent" || "$decoy_name" == "CookieAgent" ]]; then
    fail "self-check reused the product process name"
  fi
  if [[ "$DRIVE_BUNDLE_ID" == "com.johnkimec.cookie-agent" || "$decoy_bundle" == "com.johnkimec.cookie-agent" ]]; then
    fail "self-check reused the installed bundle id"
  fi
  DECOY_DATA="$(mktemp -d /tmp/cookie-m0-decoy.XXXXXX)"
  COOKIE_DATA_DIR="$DECOY_DATA" launch_verified "$decoy_bin" decoy "$decoy_name" "$decoy_bundle"
  launch_direct
  local foreign foreign_pid
  foreign="$(cookieagent_comm_pids | tr '\n' ' ')"
  log "self-check drive pid=$APP_PID process=$DRIVE_PROCESS_NAME bundle=$DRIVE_BUNDLE_ID"
  log "self-check decoy pid=$DECOY_PID process=$decoy_name bundle=$decoy_bundle"
  log "self-check foreign CookieAgent pids:${foreign:- none}"
  local drive_before decoy_before
  drive_before="$(wait_observe "$APP_PID" "$BIN" "$DRIVE_PROCESS_NAME" "$DRIVE_BUNDLE_ID")" || fail "self-check drive status item did not appear: ${drive_before:-empty}"
  decoy_before="$(wait_observe "$DECOY_PID" "$decoy_bin" "$decoy_name" "$decoy_bundle")" || fail "self-check decoy status item did not appear: ${decoy_before:-empty}"
  if status_menu_open "$drive_before"; then
    fail "self-check drive menu was already open: $drive_before"
  fi
  if status_menu_open "$decoy_before"; then
    fail "self-check decoy menu was already open: $decoy_before"
  fi
  local clicked
  clicked="$(trim_osascript "$(with_target "$APP_PID" "$BIN" "$DRIVE_PROCESS_NAME" "$DRIVE_BUNDLE_ID" click_status)")"
  if [[ "$clicked" != "$APP_PID" ]]; then
    fail "self-check click returned pid ${clicked:-empty}, drive pid is $APP_PID"
  fi
  sleep 0.4
  local drive_after decoy_after
  drive_after="$(with_target "$APP_PID" "$BIN" "$DRIVE_PROCESS_NAME" "$DRIVE_BUNDLE_ID" observe_status)"
  decoy_after="$(with_target "$DECOY_PID" "$decoy_bin" "$decoy_name" "$decoy_bundle" observe_status)"
  if [[ "$(status_field "$drive_after" 1)" != "$APP_PID" ]]; then
    fail "self-check drive observation is not pid $APP_PID: $drive_after"
  fi
  if [[ "$(status_field "$decoy_after" 1)" != "$DECOY_PID" ]]; then
    fail "self-check decoy observation is not pid $DECOY_PID: $decoy_after"
  fi
  if ! status_menu_open "$drive_after"; then
    log "self-check drive before: $drive_before"
    log "self-check drive after: $drive_after"
    fail "self-check drive menu did not open"
  fi
  if [[ "$(status_open_fields "$decoy_before")" != "$(status_open_fields "$decoy_after")" ]]; then
    log "self-check decoy before: $decoy_before"
    log "self-check decoy after: $decoy_after"
    fail "self-check touched the decoy"
  fi
  for foreign_pid in $foreign; do
    [[ -n "$foreign_pid" ]] || continue
    if ! pid_alive "$foreign_pid"; then
      fail "self-check foreign pid $foreign_pid is gone"
    fi
  done
  with_target "$APP_PID" "$BIN" "$DRIVE_PROCESS_NAME" "$DRIVE_BUNDLE_ID" click_status >/dev/null || fail "self-check could not close the drive menu"
  log "self-check left CookieAgent pids untouched:${foreign:- none}"
  log "self-check decoy pid $DECOY_PID unchanged"
}

if [[ "$feature" == "self-check" ]]; then
  run_self_check
  log "ok"
  exit 0
fi

