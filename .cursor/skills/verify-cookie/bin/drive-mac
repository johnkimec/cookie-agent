#!/bin/bash
# Mac recipe for the menu bar and the hotkey popup.
# Status stays planned until a Mac run writes verify-evidence/.
# On Linux this is the same reachability stub as drive-core.
set -euo pipefail

if [[ "$(uname -s)" != "Darwin" ]]; then
  printf '%s\n' "verified-unreachable on Linux: requires macOS"
  exit 2
fi

usage() {
  echo "usage: drive-mac [menu-bar-icon|hotkey-popup|chat|all] [--runtime fake|real] [--evidence dir]" >&2
  exit 2
}

feature="all"
runtime="fake"
evidence=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    menu-bar-icon|hotkey-popup|chat|all)
      feature="$1"
      ;;
    --runtime)
      [[ $# -ge 2 ]] || usage
      runtime="$2"
      shift
      if [[ "$runtime" != "fake" && "$runtime" != "real" ]]; then
        usage
      fi
      ;;
    --evidence)
      [[ $# -ge 2 ]] || usage
      evidence="$2"
      shift
      ;;
    *)
      usage
      ;;
  esac
  shift
done

port="${COOKIE_LLAMA_PORT:-}"
data="${COOKIE_DATA_DIR:-}"
if [[ "$runtime" == "fake" && "$port" != "18080" ]]; then
  printf '%s\n' "not-ok" "COOKIE_LLAMA_PORT must be 18080"
  exit 1
fi
embed_given="${COOKIE_EMBED_PORT:-}"
if [[ "$runtime" == "fake" && -n "$embed_given" && "$embed_given" != "18081" ]]; then
  printf '%s\n' "not-ok" "COOKIE_EMBED_PORT must be 18081"
  exit 1
fi
if [[ -z "$data" || "$data" == *"Application Support"* ]]; then
  printf '%s\n' "not-ok" "COOKIE_DATA_DIR must be a fresh temp directory, not Application Support"
  exit 1
fi

ROOT="$(cd "$(dirname "$0")/../../../.." && pwd)"
APP="${COOKIE_APP:-"$ROOT/dist/Cookie Agent.app"}"
BIN="$APP/Contents/MacOS/CookieAgent"
if [[ ! -x "$BIN" ]]; then
  printf '%s\n' "not-ok" "set COOKIE_APP to Cookie Agent.app (missing $BIN)"
  exit 1
fi

export COOKIE_DATA_DIR="$data"
export COOKIE_CORE_CWD="${COOKIE_CORE_CWD:-$ROOT}"
if [[ "$runtime" == "real" ]]; then
  unset COOKIE_CORE_COMMAND
else
  export COOKIE_LLAMA_PORT=18080
  export COOKIE_EMBED_PORT=18081
  export COOKIE_CORE_COMMAND="${COOKIE_CORE_COMMAND:-pnpm --filter @cookie-agent/core fake-core}"
fi

log() { printf '%s\n' "$*"; }

APP_PID=""
cleanup() {
  if [[ -n "$APP_PID" ]] && kill -0 "$APP_PID" 2>/dev/null; then
    kill "$APP_PID" 2>/dev/null || true
    local attempt
    for attempt in $(seq 1 40); do
      kill -0 "$APP_PID" 2>/dev/null || break
      sleep 0.5
    done
    if kill -0 "$APP_PID" 2>/dev/null; then
      kill -9 "$APP_PID" 2>/dev/null || true
    fi
    wait "$APP_PID" 2>/dev/null || true
  fi
}
trap cleanup EXIT

log "launch $BIN"
"$BIN" &
APP_PID=$!

osascript_run() {
  /usr/bin/osascript "$@"
}

fail() {
  log "not-ok"
  printf '%s\n' "$*" >&2
  exit 1
}

resolved_port() {
  if [[ "$runtime" == "fake" ]]; then
    printf '%s\n' "18080"
    return
  fi
  if [[ -z "${COOKIE_LLAMA_PORT:-}" ]]; then
    printf '%s\n' "8080"
  else
    printf '%s\n' "$COOKIE_LLAMA_PORT"
  fi
}

resolved_embed_port() {
  if [[ "$runtime" == "fake" ]]; then
    printf '%s\n' "18081"
    return
  fi
  if [[ -z "${COOKIE_EMBED_PORT:-}" ]]; then
    printf '%s\n' "8081"
  else
    printf '%s\n' "$COOKIE_EMBED_PORT"
  fi
}

PORT="$(resolved_port)"
EMBED_PORT="$(resolved_embed_port)"

port_listening() {
  lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1
}

PORT_BEFORE=0
if port_listening "$PORT"; then
  PORT_BEFORE=1
fi

llama_server_pids() {
  ps -ax -o pid=,command= | awk '
    /llama-server/ && $0 !~ /awk/ && $0 !~ /drive-mac/ { print $1 }
  '
}

llama_server_count() {
  llama_server_pids | wc -l | tr -d ' '
}

pid_file_pid() {
  local file="$COOKIE_DATA_DIR/logs/llama-server.pid"
  [[ -f "$file" ]] || return 0
  awk 'NF >= 1 { print $1; exit }' "$file"
}

pid_in_file() {
  local file="$1"
  [[ -f "$file" ]] || return 0
  awk 'NF >= 1 { print $1; exit }' "$file"
}

health_ok() {
  python3 - "$1" <<'PY'
import sys
import urllib.request
port = sys.argv[1]
url = "http://127.0.0.1:%s/health" % port
try:
    with urllib.request.urlopen(url, timeout=2) as response:
        raise SystemExit(0 if 200 <= response.status < 300 else 1)
except Exception:
    raise SystemExit(1)
PY
}

wait_health() {
  local port="$1" attempt
  for attempt in $(seq 1 40); do
    if health_ok "$port"; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

# Real runtime only. Chat port and embed port both answer /health, and both
# pid files exist. Fake mode returns without checking.
assert_both_servers() {
  [[ "$runtime" == "real" ]] || return 0
  local chat_port="${1:-$PORT}"
  local embed_port="${2:-$EMBED_PORT}"
  local dir="${3:-$COOKIE_DATA_DIR}"
  local chat_pid embed_owned
  if ! wait_health "$chat_port"; then
    fail "chat /health not ok on ${chat_port}"
  fi
  if ! wait_health "$embed_port"; then
    fail "embed /health not ok on ${embed_port}"
  fi
  chat_pid="$(pid_in_file "$dir/logs/llama-server.pid" || true)"
  embed_owned="$(pid_in_file "$dir/logs/llama-embed.pid" || true)"
  if [[ -z "$chat_pid" || -z "$embed_owned" ]]; then
    fail "pid files missing in ${dir} chat=${chat_pid:-none} embed=${embed_owned:-none}"
  fi
  log "both servers health ok chat pid=${chat_pid} port=${chat_port} embed pid=${embed_owned} port=${embed_port}"
}

pid_alive() {
  [[ -n "${1:-}" ]] || return 1
  kill -0 "$1" 2>/dev/null
}

pid_is_llama() {
  local pid="$1"
  pid_alive "$pid" || return 1
  ps -p "$pid" -o command= | awk '/llama-server/ { found=1 } END { exit found ? 0 : 1 }'
}

# cwd of a core child (pnpm or node), not llama-server. Bash 3.2: no associative arrays.
core_child_cwd() {
  local app_pid="$1"
  local queue="$app_pid"
  local seen=" $app_pid "
  while [[ -n "$queue" ]]; do
    local current="${queue%% *}"
    if [[ "$queue" == "$current" ]]; then
      queue=""
    else
      queue="${queue#* }"
    fi
    local children child
    children="$(pgrep -P "$current" 2>/dev/null || true)"
    for child in $children; do
      case "$seen" in
        *" $child "*) continue ;;
      esac
      seen="$seen$child "
      if [[ -z "$queue" ]]; then
        queue="$child"
      else
        queue="$queue $child"
      fi
      local cmd cwd
      cmd="$(ps -p "$child" -o command= 2>/dev/null || true)"
      case "$cmd" in
        *llama-server*) continue ;;
      esac
      case "$cmd" in
        *pnpm*|*@cookie-agent/core*|*fake-core.ts*|*src/index.ts*)
          cwd="$(lsof -a -p "$child" -d cwd -Fn 2>/dev/null | awk '/^n/ { sub(/^n/, ""); print; exit }' || true)"
          if [[ -n "$cwd" ]]; then
            printf '%s\n' "$cwd"
            return 0
          fi
          ;;
      esac
    done
  done
  return 1
}

open_support_dir() {
  printf '%s\n' "$HOME/Library/Application Support/com.johnkimec.cookie-agent"
}

# System Events names the process after the executable, CookieAgent,
# when the binary inside the bundle is launched directly.
# The frontmost process is read from System Events, not from inside
# `tell process "CookieAgent"` (that lookup is error -1728).
read_menu() {
  osascript_run <<'APPLESCRIPT'
tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    set itemLabel to description of statusItem
    click statusItem
    delay 0.4
    set names to name of menu items of menu 1 of statusItem
    click statusItem
  end tell
  set frontApp to name of first process whose frontmost is true
  return itemLabel & linefeed & (names as string) & linefeed & "frontmost " & frontApp
end tell
APPLESCRIPT
}

frontmost_app() {
  osascript_run -e 'tell application "System Events" to get name of first process whose frontmost is true'
}

# Primary open path. Synthetic ⌥Space and option-click are not this path.
open_via_ask() {
  osascript_run <<'APPLESCRIPT'
tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    click statusItem
    delay 0.4
    set itemCount to 0
    try
      set itemCount to count of menu items of menu 1 of statusItem
    end try
    if itemCount is 0 then
      click statusItem
      delay 0.4
    end if
    click menu item "Ask Cookie…" of menu 1 of statusItem
  end tell
end tell
APPLESCRIPT
}

# One line per identified element: identifier, role, value. Never coerce
# `entire contents` to a string (error -1700).
# A handler is compiled outside the caller's tell. `attribute` is only a
# System Events term, so axid and axtext tell System Events themselves.
dump_popup_ax() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

on coerceToString(rawValue)
  if rawValue is missing value then return ""
  set oldDelims to AppleScript's text item delimiters
  try
    if class of rawValue is list then
      set AppleScript's text item delimiters to " "
      set joined to rawValue as string
      set AppleScript's text item delimiters to oldDelims
      return joined
    end if
    set AppleScript's text item delimiters to oldDelims
    return rawValue as string
  on error
    set AppleScript's text item delimiters to oldDelims
    return ""
  end try
end coerceToString

on axtext(elem)
  set rawValue to missing value
  tell application "System Events"
    try
      set rawValue to value of elem
    end try
  end tell
  return my coerceToString(rawValue)
end axtext

tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set popupWindow to missing value
    repeat with candidate in windows
      set candidateName to ""
      set candidateSubrole to ""
      try
        set candidateName to name of candidate
      end try
      try
        set candidateSubrole to subrole of candidate as text
      end try
      if candidateName is "Ask Cookie…" or candidateSubrole is "AXSystemDialog" then
        set popupWindow to candidate
      end if
    end repeat
    if popupWindow is missing value then error "no Ask Cookie window"
    set nodes to entire contents of popupWindow
    set linesOut to {}
    set windowId to my axid(popupWindow)
    if windowId is not "" then set end of linesOut to windowId & tab & "AXWindow" & tab & ""
    repeat with elem in nodes
      set theId to my axid(elem)
      if theId is not "" then
        set theRole to ""
        try
          set theRole to role of elem as text
        end try
        set theValue to my axtext(elem)
        set end of linesOut to theId & tab & theRole & tab & theValue
      end if
    end repeat
    if linesOut is {} then error "popup exposed no AXIdentifier"
    set oldDelims to AppleScript's text item delimiters
    set AppleScript's text item delimiters to linefeed
    set output to linesOut as text
    set AppleScript's text item delimiters to oldDelims
    return output
  end tell
end tell
APPLESCRIPT
}

require_input_id() {
  python3 - <<'PY'
import pathlib, sys
from collections import Counter
text = pathlib.Path("/tmp/cookie-drive-mac-ax.txt").read_text()
ids = [line.split("\t", 1)[0] for line in text.splitlines() if line.strip()]
if "cookie.popup.input" not in ids:
    print("missing cookie.popup.input")
    print(text)
    sys.exit(1)
dupes = sorted(identifier for identifier, count in Counter(ids).items() if count > 1)
if dupes:
    print("duplicate AX identifiers: " + ", ".join(dupes))
    print(text)
    sys.exit(1)
print("popup identifiers ok")
PY
}

# Set the field through AX. System Events keystrokes go to the frontmost
# app, not this non-activating panel. AXConfirm is the field's Return.
send_chat() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set popupWindow to missing value
    repeat with candidate in windows
      set candidateName to ""
      try
        set candidateName to name of candidate
      end try
      if candidateName is "Ask Cookie…" then set popupWindow to candidate
    end repeat
    if popupWindow is missing value then
      repeat with candidate in windows
        try
          if subrole of candidate as text is "AXSystemDialog" then set popupWindow to candidate
        end try
      end repeat
    end if
    if popupWindow is missing value then error "no Ask Cookie window"
    set nodes to entire contents of popupWindow
    set inputElem to missing value
    set sendElem to missing value
    repeat with elem in nodes
      set theId to my axid(elem)
      set theRole to ""
      try
        set theRole to role of elem as text
      end try
      if theId is "cookie.popup.input" then
        if theRole is "AXTextArea" or theRole is "AXTextField" or inputElem is missing value then
          set inputElem to elem
        end if
      end if
      if theId is "cookie.popup.send" then set sendElem to elem
    end repeat
    if inputElem is missing value then error "missing cookie.popup.input"
    set value of inputElem to "hello from drive-mac"
    delay 0.2
    set confirmed to false
    try
      perform action "AXConfirm" of inputElem
      set confirmed to true
    end try
    if confirmed is false then
      if sendElem is missing value then error "cannot confirm cookie.popup.input"
      click sendElem
    end if
  end tell
end tell
APPLESCRIPT
}

cookie_turn_value() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

on coerceToString(rawValue)
  if rawValue is missing value then return ""
  set oldDelims to AppleScript's text item delimiters
  try
    if class of rawValue is list then
      set AppleScript's text item delimiters to " "
      set joined to rawValue as string
      set AppleScript's text item delimiters to oldDelims
      return joined
    end if
    set AppleScript's text item delimiters to oldDelims
    return rawValue as string
  on error
    set AppleScript's text item delimiters to oldDelims
    return ""
  end try
end coerceToString

on axtext(elem)
  set rawValue to missing value
  set rawName to missing value
  set rawDescription to missing value
  tell application "System Events"
    try
      set rawValue to value of elem
    end try
    try
      set rawName to name of elem
    end try
    try
      set rawDescription to description of elem
    end try
  end tell
  set fromValue to my coerceToString(rawValue)
  if fromValue is not "" and fromValue is not "cookie" then return fromValue
  set fromName to my coerceToString(rawName)
  if fromName is not "" and fromName is not "cookie" then return fromName
  set fromDescription to my coerceToString(rawDescription)
  if fromDescription is not "" and fromDescription is not "cookie" then return fromDescription
  return ""
end axtext

tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set popupWindow to missing value
    repeat with candidate in windows
      try
        if name of candidate is "Ask Cookie…" then set popupWindow to candidate
      end try
    end repeat
    if popupWindow is missing value then
      repeat with candidate in windows
        try
          if subrole of candidate as text is "AXSystemDialog" then set popupWindow to candidate
        end try
      end repeat
    end if
    if popupWindow is missing value then return "missing-window"
    set nodes to entire contents of popupWindow
    repeat with elem in nodes
      set theId to my axid(elem)
      if theId is "cookie.turn.cookie.0" or theId is "cookie.turn.cookie.1" then
        set theValue to my axtext(elem)
        if theValue is not "" and theValue is not "cookie" then
          return theId & tab & theValue
        end if
      end if
    end repeat
    return "waiting"
  end tell
end tell
APPLESCRIPT
}

close_popup() {
  osascript_run <<'APPLESCRIPT'
on axid(elem)
  tell application "System Events"
    try
      return value of attribute "AXIdentifier" of elem
    on error
      return ""
    end try
  end tell
end axid

tell application "System Events"
  if not (exists process "CookieAgent") then return
  tell process "CookieAgent"
    repeat with candidate in windows
      try
        if name of candidate is not "Ask Cookie…" then
          -- keep looking
        else
          set nodes to entire contents of candidate
          repeat with elem in nodes
            if my axid(elem) is "cookie.popup.input" then
              try
                perform action "AXCancel" of elem
                return
              end try
            end if
          end repeat
        end if
      end try
    end repeat
  end tell
end tell
APPLESCRIPT
}

popup_is_open() {
  osascript_run <<'APPLESCRIPT'
tell application "System Events"
  if not (exists process "CookieAgent") then return "no"
  tell process "CookieAgent"
    repeat with candidate in windows
      try
        if name of candidate is "Ask Cookie…" then return "yes"
      end try
    end repeat
  end tell
end tell
return "no"
APPLESCRIPT
}

option_click_status() {
  osascript_run <<'APPLESCRIPT'
tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
  end tell
  -- System-wide, not inside the process tell. The panel reads NSEvent.modifierFlags.
  key down option
  delay 0.1
  try
    tell process "CookieAgent" to click statusItem
    key up option
  on error errText
    try
      key up option
    end try
    error errText
  end try
end tell
APPLESCRIPT
}

wait_for_menu() {
  local attempt
  for attempt in $(seq 1 30); do
    if read_menu > /tmp/cookie-drive-mac-menu.txt 2>/tmp/cookie-drive-mac-menu.err; then
      return 0
    fi
    sleep 0.5
  done
  return 1
}

wait_for_runtime_up() {
  local attempt
  for attempt in $(seq 1 120); do
    if read_menu > /tmp/cookie-drive-mac-menu.txt 2>/tmp/cookie-drive-mac-menu.err; then
      if python3 - <<'PY'
import pathlib, sys
text = pathlib.Path("/tmp/cookie-drive-mac-menu.txt").read_text()
if "fake-local" in text or "starting model" in text or "model offline" in text:
    sys.exit(1)
required = ["Ask Cookie…", "Local-only mode", "Quit Cookie", "🐾 Cookie · on-device · "]
missing = [item for item in required if item not in text]
if missing:
    sys.exit(1)
sys.exit(0)
PY
      then
        return 0
      fi
    fi
    sleep 1
  done
  return 1
}

log "wait for menu bar"
if ! wait_for_menu; then
  log "not-ok"
  log "menu bar did not appear"
  cat /tmp/cookie-drive-mac-menu.err || true
  exit 1
fi
log "menu"
cat /tmp/cookie-drive-mac-menu.txt

if [[ "$runtime" == "real" ]]; then
  log "wait for runtime up"
  if ! wait_for_runtime_up; then
    log "not-ok"
    log "runtime did not reach up within 120s"
    cat /tmp/cookie-drive-mac-menu.txt 2>/dev/null || true
    cat /tmp/cookie-drive-mac-menu.err 2>/dev/null || true
    exit 1
  fi
  log "runtime up"
  cat /tmp/cookie-drive-mac-menu.txt
  assert_both_servers
else
  python3 - <<'PY' || fail "menu strings"
import pathlib, sys
text = pathlib.Path("/tmp/cookie-drive-mac-menu.txt").read_text()
required = ["Ask Cookie…", "Local-only mode", "Quit Cookie", "🐾 Cookie · on-device · fake-local"]
missing = [item for item in required if item not in text]
if missing:
    print("missing " + ", ".join(missing))
    sys.exit(1)
print("menu strings ok")
PY
fi

drive_popup=0
drive_chat=0
if [[ "$feature" == "hotkey-popup" || "$feature" == "chat" || "$feature" == "all" || "$runtime" == "real" ]]; then
  drive_popup=1
fi
if [[ "$feature" == "chat" || "$feature" == "all" || "$runtime" == "real" ]]; then
  drive_chat=1
fi

if [[ "$drive_popup" == "1" ]]; then
  before="$(frontmost_app)"
  log "frontmost-before $before"
  log "open via Ask Cookie…"
  open_via_ask
  sleep 0.6
  after="$(frontmost_app)"
  log "frontmost-after $after"
  if [[ "$before" != "$after" ]]; then
    fail "frontmost changed from $before to $after"
  fi
  if ! dump_popup_ax > /tmp/cookie-drive-mac-ax.txt; then
    fail "popup accessibility read failed"
  fi
  log "popup identifiers"
  cat /tmp/cookie-drive-mac-ax.txt
  require_input_id || fail "missing cookie.popup.input"
fi

if [[ "$drive_chat" == "1" ]]; then
  log "send chat"
  send_chat
  turn_line=""
  chat_tries=40
  chat_sleep=0.25
  if [[ "$runtime" == "real" ]]; then
    chat_tries=120
    chat_sleep=1
  fi
  for _ in $(seq 1 "$chat_tries"); do
    turn_line="$(cookie_turn_value || true)"
    case "$turn_line" in
      cookie.turn.cookie.*)
        break
        ;;
    esac
    sleep "$chat_sleep"
  done
  if [[ "$turn_line" != cookie.turn.cookie.* ]]; then
    dump_popup_ax > /tmp/cookie-drive-mac-ax.txt || true
    log "popup identifiers after wait"
    cat /tmp/cookie-drive-mac-ax.txt || true
    fail "cookie turn did not gain text (last: ${turn_line:-empty})"
  fi
  log "chat $turn_line"
  printf '%s\n' "$turn_line" > /tmp/cookie-drive-mac-chat.txt
  python3 - "$turn_line" "$runtime" <<'PY' || fail "reply text"
import sys
line, runtime = sys.argv[1], sys.argv[2]
fake = "I'm here. This reply is from the fake core, with no model loaded."
stub = "Hello. This reply is from the local stub, on device."
text = line.split("\t", 1)[1].strip() if "\t" in line else ""
if not text or text == "cookie":
    print("empty reply")
    sys.exit(1)
if runtime == "real" and (text == fake or text == stub or fake in text or stub in text):
    print("canned reply")
    sys.exit(1)
print("reply ok")
PY
  shot="/tmp/cookie-drive-mac-popup.png"
  screencapture -x "$shot"
  if [[ ! -s "$shot" ]]; then
    fail "screencapture wrote no file"
  fi
  log "screenshot $shot"
fi

if [[ -n "$evidence" ]]; then
  mkdir -p "$evidence"
  {
    printf '%s\n' "drive-mac $feature --runtime $runtime"
    printf '%s\n' "COOKIE_DATA_DIR=$COOKIE_DATA_DIR"
    printf '%s\n' "COOKIE_LLAMA_PORT=${COOKIE_LLAMA_PORT:-}"
    printf '%s\n' "COOKIE_EMBED_PORT=${COOKIE_EMBED_PORT:-}"
    printf '%s\n' "resolvedPort=${PORT}"
    printf '%s\n' "resolvedEmbedPort=${EMBED_PORT}"
    printf '%s\n' "COOKIE_CORE_COMMAND=${COOKIE_CORE_COMMAND:-}"
  } > "$evidence/command.txt"
  cp /tmp/cookie-drive-mac-menu.txt "$evidence/menu.txt"
  if [[ -f /tmp/cookie-drive-mac-ax.txt ]]; then
    cp /tmp/cookie-drive-mac-ax.txt "$evidence/ax.txt"
  fi
  if [[ "$drive_chat" == "1" ]]; then
    if [[ ! -s /tmp/cookie-drive-mac-chat.txt ]]; then
      fail "chat.txt was not written"
    fi
    if [[ ! -s /tmp/cookie-drive-mac-popup.png ]]; then
      fail "popup screenshot was not written"
    fi
    cp /tmp/cookie-drive-mac-chat.txt "$evidence/chat.txt"
    cp /tmp/cookie-drive-mac-popup.png "$evidence/popup.png"
    if [[ ! -s "$evidence/chat.txt" || ! -s "$evidence/popup.png" ]]; then
      fail "evidence is missing chat.txt or popup.png"
    fi
  fi
fi

if [[ "$feature" == "menu-bar-icon" || "$feature" == "hotkey-popup" || "$feature" == "all" ]]; then
  log "option-click"
  if [[ "$(popup_is_open)" == "yes" ]]; then
    close_popup
    sleep 0.4
  fi
  if [[ "$(popup_is_open)" == "yes" ]]; then
    fail "popup stayed open, so option-click was not a fresh open"
  fi
  option_click_status
  sleep 0.6
  if [[ "$(popup_is_open)" != "yes" ]]; then
    fail "option-click did not open the Ask Cookie window"
  fi
  log "option-click opened popup"
fi

relaunch_app() {
  "$BIN" &
  APP_PID=$!
  if ! wait_for_menu; then
    fail "menu bar did not return after relaunch"
  fi
  if [[ "$runtime" == "real" ]]; then
    if ! wait_for_runtime_up; then
      fail "runtime did not return after relaunch"
    fi
  fi
}

# kill -9 skips applicationShouldTerminate, so a server we launched is
# orphaned until the next launch reaps it. Fake mode has no llama-server.
# Real mode runs the chat server and the embedding server, so two processes
# is the ceiling.
orphan_reap_check() {
  local old_pid old_embed count limit
  old_pid="$(pid_file_pid || true)"
  old_embed=""
  if [[ "$runtime" == "real" ]]; then
    old_embed="$(pid_in_file "$COOKIE_DATA_DIR/logs/llama-embed.pid" || true)"
  fi
  log "orphan-reap kill -9 ${APP_PID} pidfile=${old_pid:-none} embed=${old_embed:-none}"
  kill -9 "$APP_PID" 2>/dev/null || true
  wait "$APP_PID" 2>/dev/null || true
  APP_PID=""
  sleep 0.5
  relaunch_app
  count="$(llama_server_count)"
  if [[ "$runtime" == "real" ]]; then
    limit=2
  else
    limit=1
  fi
  log "orphan-reap llama-server count ${count}"
  if [[ "$count" -gt "$limit" ]]; then
    fail "orphan reap left ${count} llama-server processes: $(llama_server_pids | tr '\n' ' ')"
  fi
  if [[ "$runtime" == "fake" && "$count" != "0" ]]; then
    fail "fake runtime has llama-server after relaunch"
  fi
  if [[ -n "$old_pid" ]] && pid_is_llama "$old_pid"; then
    if [[ "$runtime" != "real" && "$count" != "1" ]]; then
      fail "old llama-server ${old_pid} still alive with ${count} servers"
    fi
    log "orphan-reap reused ${old_pid}"
  else
    log "orphan-reap old server gone"
  fi
  if [[ -n "$old_embed" ]] && pid_is_llama "$old_embed"; then
    log "orphan-reap reused embed ${old_embed}"
  fi
  if [[ "$runtime" == "real" ]]; then
    assert_both_servers
  fi
}

orphan_reap_check

owned_before_quit="$(pid_file_pid || true)"
owned_embed_before=""
embed_port_now="$EMBED_PORT"
if [[ "$runtime" == "real" ]]; then
  owned_embed_before="$(pid_in_file "$COOKIE_DATA_DIR/logs/llama-embed.pid" || true)"
fi
log "quit via menu pid=${owned_before_quit:-none} embed=${owned_embed_before:-none} port=${PORT}"
osascript_run <<'APPLESCRIPT'
tell application "System Events"
  if not (exists process "CookieAgent") then error "CookieAgent is not running"
  tell process "CookieAgent"
    set statusItem to missing value
    repeat with barIndex from 1 to (count of menu bars)
      if (count of menu bar items of menu bar barIndex) > 0 then
        set statusItem to menu bar item 1 of menu bar barIndex
      end if
    end repeat
    if statusItem is missing value then error "no menu bar item"
    click statusItem
    delay 0.3
    click menu item "Quit Cookie" of menu 1 of statusItem
  end tell
end tell
APPLESCRIPT

quit_exited=0
for _ in $(seq 1 60); do
  if ! kill -0 "$APP_PID" 2>/dev/null; then
    quit_exited=1
    break
  fi
  sleep 0.5
done
if [[ "$quit_exited" != "1" ]]; then
  fail "app still running after Quit Cookie"
fi
wait "$APP_PID" 2>/dev/null || true
APP_PID=""

owned_pid="$(pid_file_pid || true)"
if [[ -n "${owned_before_quit:-}" ]]; then
  if pid_is_llama "$owned_before_quit"; then
    fail "llama-server ${owned_before_quit} still alive after quit"
  fi
  if port_listening "$PORT"; then
    fail "port ${PORT} still listening after quit"
  fi
  if [[ -n "$owned_pid" ]]; then
    fail "pid file remains after quit (${owned_pid})"
  fi
  log "quit reaped ${owned_before_quit} port ${PORT} clear"
else
  if [[ "$PORT_BEFORE" == "0" ]]; then
    if port_listening "$PORT"; then
      fail "port ${PORT} is listening after quit"
    fi
  elif ! port_listening "$PORT"; then
    fail "quit stopped a server this app did not launch on port ${PORT}"
  fi
  log "quit left port ${PORT} listener state unchanged"
fi

if [[ "$runtime" == "real" ]]; then
  if [[ -z "$owned_embed_before" ]]; then
    fail "llama-embed.pid missing before quit"
  fi
  if pid_is_llama "$owned_embed_before"; then
    fail "llama-embed ${owned_embed_before} still alive after quit"
  fi
  if port_listening "$embed_port_now"; then
    fail "embed port ${embed_port_now} still listening after quit"
  fi
  if [[ -n "$(pid_in_file "$COOKIE_DATA_DIR/logs/llama-embed.pid" || true)" ]]; then
    fail "llama-embed.pid remains after quit"
  fi
  log "quit reaped embed ${owned_embed_before} port ${embed_port_now} clear"
fi

cookie_agent_pids() {
  pgrep -x CookieAgent 2>/dev/null || true
}

# Quit can still be reaping when the next step starts. Bash 3.2: no arrays.
wait_for_no_cookie_agent() {
  local attempt
  for attempt in $(seq 1 40); do
    if [[ -z "$(cookie_agent_pids)" ]]; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

log_cookie_processes() {
  log "ps pid ppid lstart command:"
  ps -ax -o pid,ppid,lstart,command | awk 'NR==1 || ((/CookieAgent/ || /llama-server/) && $0 !~ /awk/)' || true
}

shell_log_bytes() {
  local file="$1"
  if [[ ! -f "$file" ]]; then
    printf '%s\n' "0"
    return
  fi
  wc -c < "$file" | tr -d ' '
}

dump_shell_log_since() {
  local file="$1" mark="$2"
  log "shell log since byte ${mark}:"
  if [[ ! -f "$file" ]]; then
    log "(no $file)"
    return
  fi
  tail -c +$((mark + 1)) "$file" || true
}

# Finder and `open` pass no COOKIE_* variables and a minimal PATH.
# LaunchServices does not keep this shell's environment. env -i is the
# same shape John gets from `open -n`.
open_clean_check() {
  if ! wait_for_no_cookie_agent; then
    log_cookie_processes
    fail "CookieAgent still running before open launch"
  fi
  local support port_before shell_log log_mark
  support="$(open_support_dir)"
  shell_log="$support/logs/cookie-shell.log"
  log_mark="$(shell_log_bytes "$shell_log")"
  port_before=0
  if port_listening 8080; then
    port_before=1
  fi
  local before
  before="$(cookie_agent_pids)"
  log "open -n clean env support=$support existing=${before:-none}"
  env -i \
    HOME="$HOME" \
    USER="${USER:-$(id -un)}" \
    LOGNAME="${USER:-$(id -un)}" \
    TMPDIR="${TMPDIR:-/tmp}" \
    PATH="/usr/bin:/bin:/usr/sbin:/sbin" \
    /usr/bin/open -n "$APP"
  local attempt pid current fresh="" count=0
  for attempt in $(seq 1 40); do
    current="$(cookie_agent_pids)"
    fresh=""
    count=0
    for pid in $current; do
      case " $before " in
        *" $pid "*) ;;
        *)
          fresh="$fresh $pid"
          count=$((count + 1))
          ;;
      esac
    done
    if [[ "$count" -eq 1 ]]; then
      break
    fi
    if [[ "$count" -gt 1 ]]; then
      log_cookie_processes
      fail "open started more than one CookieAgent:$fresh"
    fi
    fresh=""
    sleep 0.25
  done
  if [[ "$count" -ne 1 ]]; then
    log_cookie_processes
    fail "open did not start CookieAgent"
  fi
  APP_PID="${fresh# }"
  log "open pid=$APP_PID"
  local ready=0
  for attempt in $(seq 1 40); do
    if [[ -f "$shell_log" ]] && tail -c +$((log_mark + 1)) "$shell_log" 2>/dev/null | grep -E "signals installed pid=${APP_PID}([^0-9]|$)" >/dev/null; then
      ready=1
      break
    fi
    sleep 0.25
  done
  if [[ "$ready" != "1" ]]; then
    dump_shell_log_since "$shell_log" "$log_mark"
    fail "signals installed line did not appear for pid $APP_PID"
  fi
  local recorded=""
  if [[ -f "$support/logs/cookie-agent.pid" ]]; then
    recorded="$(awk 'NF >= 1 { print $1; exit }' "$support/logs/cookie-agent.pid")"
  fi
  if [[ "$recorded" != "$APP_PID" ]]; then
    fail "cookie-agent.pid is ${recorded:-missing}, open pid is $APP_PID"
  fi
  log "signals installed pid=$APP_PID"
  local cwd="" menu_text=""
  for attempt in $(seq 1 40); do
    if read_menu > /tmp/cookie-drive-mac-menu.txt 2>/tmp/cookie-drive-mac-menu.err; then
      menu_text="$(cat /tmp/cookie-drive-mac-menu.txt || true)"
      case "$menu_text" in
        *"core not found"*|*"pnpm not found"*|*"core can't start"*)
          fail "open launch menu: $menu_text"
          ;;
      esac
    fi
    cwd="$(core_child_cwd "$APP_PID" || true)"
    if [[ -n "$cwd" && -f "$cwd/core/package.json" ]]; then
      break
    fi
    cwd=""
    sleep 0.5
  done
  if [[ -z "$cwd" ]]; then
    fail "core did not start from a directory with core/package.json"
  fi
  local expected actual
  expected="$(cd "$ROOT" && pwd -P)"
  actual="$(cd "$cwd" && pwd -P)"
  if [[ "$actual" != "$expected" ]]; then
    fail "core cwd $actual is not $expected"
  fi
  log "open core cwd=$actual"
  if [[ "$runtime" == "real" ]]; then
    if ! wait_for_runtime_up; then
      fail "open launch runtime did not reach up"
    fi
    log "open runtime up"
  fi
  # read_menu leaves the status item in event-tracking mode if the closing
  # click does not land. Escape returns the run loop to the default mode
  # before SIGTERM. The app also accepts the hop in that tracking mode.
  osascript_run -e 'tell application "System Events" to key code 53' >/dev/null 2>&1 || true
  sleep 0.3
  local pidfile owned=""
  pidfile="$support/logs/llama-server.pid"
  if [[ -f "$pidfile" ]]; then
    owned="$(awk 'NF >= 1 { print $1; exit }' "$pidfile")"
  fi
  local term_port="8080"
  if [[ -f "$support/logs/llama-server.log" ]]; then
    local parsed
    parsed="$(awk 'match($0, /--port [0-9]+/) { print substr($0, RSTART+7, RLENGTH-7); exit }' "$support/logs/llama-server.log" || true)"
    if [[ -n "$parsed" ]]; then
      term_port="$parsed"
    fi
  fi
  local embed_file embed_owned="" embed_term_port="8081"
  embed_file="$support/logs/llama-embed.pid"
  if [[ -f "$embed_file" ]]; then
    embed_owned="$(awk 'NF >= 1 { print $1; exit }' "$embed_file")"
  fi
  if [[ -f "$support/logs/llama-embed.log" ]]; then
    local embed_parsed
    embed_parsed="$(awk 'match($0, /--port [0-9]+/) { print substr($0, RSTART+7, RLENGTH-7); exit }' "$support/logs/llama-embed.log" || true)"
    if [[ -n "$embed_parsed" ]]; then
      embed_term_port="$embed_parsed"
    fi
  fi
  if [[ "$runtime" == "real" ]]; then
    assert_both_servers "$term_port" "$embed_term_port" "$support"
  fi
  local signal_mark
  signal_mark="$(shell_log_bytes "$shell_log")"
  log_cookie_processes
  log "SIGTERM target pid=$APP_PID pidfile=${owned:-none} embed=${embed_owned:-none} port=$term_port embedPort=$embed_term_port"
  kill -TERM "$APP_PID" || true
  local exited=0
  for attempt in $(seq 1 40); do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
      exited=1
      break
    fi
    sleep 0.5
  done
  dump_shell_log_since "$shell_log" "$signal_mark"
  if [[ "$exited" != "1" ]]; then
    log_cookie_processes
    fail "CookieAgent still running after SIGTERM"
  fi
  wait "$APP_PID" 2>/dev/null || true
  APP_PID=""
  if [[ -n "$owned" ]]; then
    if pid_is_llama "$owned"; then
      fail "llama-server ${owned} still alive after SIGTERM"
    fi
    if port_listening "$term_port"; then
      fail "port ${term_port} still listening after SIGTERM"
    fi
    log "SIGTERM reaped ${owned} port ${term_port} clear"
  elif [[ "$port_before" == "0" ]]; then
    if port_listening 8080; then
      fail "port 8080 is listening after SIGTERM"
    fi
    log "SIGTERM left port 8080 clear"
  else
    if ! port_listening 8080; then
      fail "SIGTERM stopped a server this app did not launch on port 8080"
    fi
    log "SIGTERM left an existing port 8080 listener"
  fi
  if [[ "$runtime" == "real" ]]; then
    if [[ -z "$embed_owned" ]]; then
      fail "llama-embed.pid missing before SIGTERM"
    fi
    if pid_is_llama "$embed_owned"; then
      fail "llama-embed ${embed_owned} still alive after SIGTERM"
    fi
    if port_listening "$embed_term_port"; then
      fail "embed port ${embed_term_port} still listening after SIGTERM"
    fi
    if [[ -f "$embed_file" ]]; then
      fail "llama-embed.pid remains after SIGTERM"
    fi
    log "SIGTERM reaped embed ${embed_owned} port ${embed_term_port} clear"
  fi
}

open_clean_check

log "ok"
log "Mac proof is pending until this transcript is saved under verify-evidence/ and the feature files are updated."
