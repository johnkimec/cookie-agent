# Sourced by drive-mac on macOS. Each recipe asserts one planned sub-feature.
# Status stays planned until Sergey runs the recipe and keeps the evidence.

SCRIPTS="$ROOT/.cursor/skills/verify-cookie/bin/scripts"
STUB_JS="$ROOT/.cursor/skills/verify-cookie/bin/llama-fault-stub.mjs"
FAKE_REPLY="I'm here. This reply is from the fake core, with no model loaded."
LOCAL_REPLY="Hello. This reply is from the local stub, on device."
STATUS_UP_FAKE="🐾 Cookie · on-device · fake-local"
STATUS_UP_QWEN="🐾 Cookie · on-device · Qwen3.6"
STATUS_LOADING="🐾 Cookie · starting model…"
STATUS_DOWN="🐾 Cookie · model offline"
LOADING_LINE="Loading the model…"
NOT_READY="Cookie's model isn't ready yet."

note() {
  log "$@"
  printf '%s\n' "$*" >>"$evidence/summary.txt"
}

write_command() {
  mkdir -p "$evidence"
  : >"$evidence/summary.txt"
  {
    printf '%s\n' "drive-mac $feature --evidence $evidence"
    printf '%s\n' "COOKIE_DATA_DIR=${COOKIE_DATA_DIR:-}"
    printf '%s\n' "COOKIE_LLAMA_PORT=${COOKIE_LLAMA_PORT:-}"
    printf '%s\n' "COOKIE_CORE_COMMAND=${COOKIE_CORE_COMMAND-<unset>}"
    printf '%s\n' "COOKIE_CORE_CWD=${COOKIE_CORE_CWD:-}"
    printf '%s\n' "COOKIE_FAKE_DELTA_MS=${COOKIE_FAKE_DELTA_MS-<unset>}"
    printf '%s\n' "COOKIE_DRIVE_KEYS=${COOKIE_DRIVE_KEYS-<unset>}"
    printf '%s\n' "COOKIE_DRAFT_TTL_SECONDS=${COOKIE_DRAFT_TTL_SECONDS-<unset>}"
    printf '%s\n' "COOKIE_LLAMA_SERVER=${COOKIE_LLAMA_SERVER-<unset>}"
    printf '%s\n' "COOKIE_LLAMA_FAULT=${COOKIE_LLAMA_FAULT-<unset>}"
  } >"$evidence/command.txt"
}

refresh_command() {
  {
    printf '%s\n' "drive-mac $feature --evidence $evidence"
    printf '%s\n' "COOKIE_DATA_DIR=${COOKIE_DATA_DIR:-}"
    printf '%s\n' "COOKIE_LLAMA_PORT=${COOKIE_LLAMA_PORT:-}"
    printf '%s\n' "COOKIE_CORE_COMMAND=${COOKIE_CORE_COMMAND-<unset>}"
    printf '%s\n' "COOKIE_CORE_CWD=${COOKIE_CORE_CWD:-}"
    printf '%s\n' "COOKIE_FAKE_DELTA_MS=${COOKIE_FAKE_DELTA_MS-<unset>}"
    printf '%s\n' "COOKIE_DRIVE_KEYS=${COOKIE_DRIVE_KEYS-<unset>}"
    printf '%s\n' "COOKIE_DRAFT_TTL_SECONDS=${COOKIE_DRAFT_TTL_SECONDS-<unset>}"
    printf '%s\n' "COOKIE_LLAMA_SERVER=${COOKIE_LLAMA_SERVER-<unset>}"
    printf '%s\n' "COOKIE_LLAMA_FAULT=${COOKIE_LLAMA_FAULT-<unset>}"
  } >"$evidence/command.txt"
}

focused_launch() {
  refresh_command
  if [[ -z "${DRIVE_PROCESS_NAME:-}" || "$DRIVE_PROCESS_NAME" == "CookieAgent" ]]; then
    install_prepared_identity "$SOURCE_APP"
  fi
  note "launch $BIN process=$DRIVE_PROCESS_NAME bundle=$DRIVE_BUNDLE_ID"
  launch_direct
  if ! wait_for_menu; then
    fail "menu bar did not appear"
  fi
}

quit_focused() {
  if [[ -z "${APP_PID:-}" ]] || ! kill -0 "$APP_PID" 2>/dev/null; then
    APP_PID=""
    return 0
  fi
  osascript_run "$SCRIPTS/quit-cookie.applescript" || true
  local attempt
  for attempt in $(seq 1 50); do
    if ! kill -0 "$APP_PID" 2>/dev/null; then
      wait "$APP_PID" 2>/dev/null || true
      APP_PID=""
      return 0
    fi
    sleep 0.5
  done
  fail "app still running after Quit Cookie"
}

require_port_free() {
  if port_listening 18080; then
    fail "port 18080 is already listening; this recipe leaves that listener alone"
  fi
}

install_fault_wrapper() {
  local mode="$1"
  local node_bin wrapper
  node_bin="$(command -v node || true)"
  [[ -n "$node_bin" ]] || fail "node is not on PATH"
  wrapper="$evidence/llama-fault-wrapper"
  {
    printf '%s\n' '#!/bin/bash'
    printf 'export COOKIE_LLAMA_FAULT=%q\n' "$mode"
    printf 'exec %q %q "$@"\n' "$node_bin" "$STUB_JS"
  } >"$wrapper"
  chmod +x "$wrapper"
  export COOKIE_LLAMA_SERVER="$wrapper"
  export COOKIE_LLAMA_FAULT="$mode"
  unset COOKIE_CORE_COMMAND
}

use_fake_core() {
  unset COOKIE_LLAMA_SERVER COOKIE_LLAMA_FAULT
  export COOKIE_LLAMA_PORT=18080
  export COOKIE_CORE_COMMAND="pnpm --filter @cookie-agent/core fake-core"
}

start_up_stub() {
  local node_bin attempt pid
  node_bin="$(command -v node || true)"
  [[ -n "$node_bin" ]] || fail "node is not on PATH"
  require_port_free
  "$node_bin" "$STUB_JS" --mode up --port 18080 >"$evidence/stub.log" 2>&1 &
  STUB_PID=$!
  for attempt in $(seq 1 50); do
    if curl -sf -m 1 "http://127.0.0.1:18080/health" >/dev/null; then
      note "up stub pid=$STUB_PID"
      return 0
    fi
    pid="$STUB_PID"
    if ! kill -0 "$pid" 2>/dev/null; then
      fail "up stub exited"
    fi
    sleep 0.1
  done
  fail "up stub did not answer /health"
}

export_blackhole_proxy() {
  export http_proxy=http://127.0.0.1:9
  export https_proxy=http://127.0.0.1:9
  export HTTP_PROXY=http://127.0.0.1:9
  export HTTPS_PROXY=http://127.0.0.1:9
  export ALL_PROXY=http://127.0.0.1:9
  export all_proxy=http://127.0.0.1:9
  export NO_PROXY=127.0.0.1,localhost
  export no_proxy=127.0.0.1,localhost
}

shoot() {
  local dest="$1"
  screencapture -x "$dest"
  if [[ ! -s "$dest" ]]; then
    fail "screencapture wrote no file ($dest)"
  fi
}

menu_label() {
  osascript_run "$SCRIPTS/menu-label.applescript"
}

wait_menu_contains() {
  local needle="$1"
  local tries="${2:-40}"
  local attempt
  for attempt in $(seq 1 "$tries"); do
    if read_menu >"$evidence/menu.txt" 2>"$evidence/menu.err"; then
      if grep -F "$needle" "$evidence/menu.txt" >/dev/null; then
        return 0
      fi
    fi
    sleep 0.5
  done
  return 1
}

wait_label() {
  local want="$1"
  local tries="${2:-40}"
  local attempt label
  for attempt in $(seq 1 "$tries"); do
    label="$(menu_label || true)"
    printf '%s\n' "$label" >"$evidence/label.txt"
    if [[ "$label" == "$want" ]]; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

dump_ax() {
  local dest="$1"
  if ! osascript_run "$SCRIPTS/popup-dump.applescript" >"$dest"; then
    fail "popup accessibility read failed"
  fi
}

open_popup() {
  if [[ "$(popup_is_open)" != "yes" ]]; then
    open_via_ask
    sleep 0.6
  fi
  if [[ "$(popup_is_open)" != "yes" ]]; then
    fail "popup did not open"
  fi
}

close_popup_if_open() {
  if [[ "$(popup_is_open)" == "yes" ]]; then
    osascript_run "$SCRIPTS/popup-action.applescript" cancel
    sleep 0.4
  fi
  if [[ "$(popup_is_open)" == "yes" ]]; then
    fail "popup stayed open"
  fi
}

set_field() {
  export COOKIE_AX_TEXT="$1"
  osascript_run "$SCRIPTS/popup-action.applescript" set
}

press_action() {
  osascript_run "$SCRIPTS/popup-action.applescript" press "$1"
}

assert_ax() {
  python3 "$SCRIPTS/assert-ax.py" "$@"
}

assert_mark() {
  local file="$1"
  local result
  result="$(assert_ax mark "$file")" || fail "Local-only mode was not checked ($(cat "$file"))"
  note "$result"
}

capture_mark() {
  local dest="$1"
  local shot="$2"
  if ! osascript_run "$SCRIPTS/menu-mark.applescript" "$shot" >"$dest"; then
    fail "could not read the Local-only check mark"
  fi
  assert_mark "$dest"
  if [[ ! -s "$shot" ]]; then
    fail "menu screenshot was not written"
  fi
}

save_logs() {
  if [[ -f "$COOKIE_DATA_DIR/logs/cookie-shell.log" ]]; then
    cp "$COOKIE_DATA_DIR/logs/cookie-shell.log" "$evidence/cookie-shell.log"
  fi
  if [[ -f "$COOKIE_DATA_DIR/logs/llama-server.log" ]]; then
    cp "$COOKIE_DATA_DIR/logs/llama-server.log" "$evidence/llama-server.log"
  fi
}

spawn_count() {
  local log="$COOKIE_DATA_DIR/logs/llama-server.log"
  [[ -f "$log" && -n "${COOKIE_LLAMA_SERVER:-}" ]] || {
    printf '%s\n' 0
    return
  }
  grep -c -F "$COOKIE_LLAMA_SERVER" "$log" || true
}

assert_no_egress() {
  local root="$1"
  local queue="$root"
  local seen=" $root "
  : >"$evidence/sockets.txt"
  while [[ -n "$queue" ]]; do
    local current="${queue%% *}"
    if [[ "$queue" == "$current" ]]; then
      queue=""
    else
      queue="${queue#* }"
    fi
    printf 'pid %s\n' "$current" >>"$evidence/sockets.txt"
    lsof -nP -a -p "$current" -iTCP -Fn >>"$evidence/sockets.txt" 2>/dev/null || true
    local children child
    children="$(pgrep -P "$current" 2>/dev/null || true)"
    for child in $children; do
      case "$seen" in
        *" $child "*) continue ;;
      esac
      seen="$seen$child "
      if [[ -z "$queue" ]]; then
        queue="$child"
      else
        queue="$queue $child"
      fi
    done
  done
  assert_ax egress "$evidence/sockets.txt" || fail "a non-loopback socket was open"
  note "sockets loopback"
}

recipe_menu_local_only() {
  use_fake_core
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_FAKE" 40; then
    fail "menu did not show $STATUS_UP_FAKE"
  fi
  capture_mark "$evidence/mark.txt" "$evidence/menu.png"
  note "menu-local-only name=Local-only mode mark set"
  quit_focused
}

recipe_menu_option_click() {
  use_fake_core
  focused_launch
  close_popup_if_open
  option_click_status
  sleep 0.6
  if [[ "$(popup_is_open)" != "yes" ]]; then
    fail "option-click did not open the popup"
  fi
  dump_ax "$evidence/ax.txt"
  assert_ax field-label "$evidence/ax.txt" "Ask Cookie…" || fail "option-click field was not Ask Cookie…"
  shoot "$evidence/popup.png"
  note "menu-option-click opened cookie.popup.input Ask Cookie…"
  quit_focused
}

recipe_popup_option_click() {
  use_fake_core
  focused_launch
  close_popup_if_open
  option_click_status
  sleep 0.6
  if [[ "$(popup_is_open)" != "yes" ]]; then
    fail "option-click did not open the panel"
  fi
  dump_ax "$evidence/ax.txt"
  assert_ax panel "$evidence/ax.txt" || fail "option-click panel did not match"
  shoot "$evidence/popup.png"
  note "popup-option-click panel Ask Cookie… AXSystemDialog"
  quit_focused
}

recipe_popup_hotkey() {
  local others
  others="$(cookieagent_comm_pids | tr '\n' ' ')"
  if [[ -n "${others// /}" ]]; then
    log "popup-hotkey skipped: a CookieAgent is running (pid ${others}); not sending option-space"
    {
      printf '%s\n' "popup-hotkey skipped"
      printf '%s\n' "reason=a CookieAgent is running"
      printf '%s\n' "pids=${others}"
      printf '%s\n' "signaled=none"
    } >"$evidence/popup-hotkey-skip.txt"
    printf '%s\n' "popup-hotkey=skipped" >>"$evidence/command.txt"
    log "skipped"
    exit 3
  fi
  use_fake_core
  focused_launch
  if ! hotkey_registered; then
    fail "RegisterEventHotKey failed; not sending option-space"
  fi
  if [[ "$(popup_is_open)" == "yes" ]]; then
    fail "popup was already open before option-space"
  fi
  toggle_hotkey yes "open"
  sleep 0.45
  toggle_hotkey no "close"
  sleep 0.45
  toggle_hotkey yes "open again"
  note "popup-hotkey toggled open, closed, open"
  quit_focused
}

hotkey_registered() {
  local file hit=0
  if [[ ! -f "$evidence/app-stderr.txt" ]]; then
    note "popup-hotkey has no stderr log"
    return 1
  fi
  for file in "$evidence/app-stderr.txt" "$COOKIE_DATA_DIR/logs/cookie-shell.log"; do
    [[ -f "$file" ]] || continue
    if grep -F "RegisterEventHotKey failed" "$file" >/dev/null; then
      hit=1
      note "RegisterEventHotKey failed in $file"
      grep -F "RegisterEventHotKey failed" "$file" | while IFS= read -r line; do
        note "$line"
      done
    fi
  done
  if [[ "$hit" == "1" ]]; then
    return 1
  fi
  note "RegisterEventHotKey registered"
  return 0
}

toggle_hotkey() {
  local want="$1"
  local why="$2"
  local attempt state
  guard_popup_hotkey_send "${APP_PID:-}" "${evidence:-}"
  send_key_code 49 option hotkey
  for attempt in $(seq 1 20); do
    state="$(popup_is_open)"
    if [[ "$state" == "$want" ]]; then
      note "⌥Space $why -> $state"
      return 0
    fi
    sleep 0.15
  done
  report_hotkey_failure
  fail "⌥Space did not $why the popup"
}

report_hotkey_failure() {
  local front
  front="$(frontmost_app || true)"
  note "frontmost ${front:-unknown}"
  if [[ -f "$evidence/app-stderr.txt" ]] && grep -F "RegisterEventHotKey failed" "$evidence/app-stderr.txt" >/dev/null; then
    grep -F "RegisterEventHotKey failed" "$evidence/app-stderr.txt" | while IFS= read -r line; do
      note "$line"
    done
  else
    note "RegisterEventHotKey did not report a failure. macOS does not name the app that owns ⌥Space."
  fi
}

