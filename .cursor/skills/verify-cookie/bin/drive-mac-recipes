  use_fake_core
  focused_launch
  open_popup
  osascript_run "$SCRIPTS/popup-action.applescript" cancel
  sleep 0.4
  if [[ "$(popup_is_open)" != "no" ]]; then
    fail "Escape did not close the popup"
  fi
  note "popup-escape closed"
  quit_focused
}

