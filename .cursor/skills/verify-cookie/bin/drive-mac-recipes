  use_fake_core
  focused_launch
  open_popup
  sleep 1.2
  osascript_run "$SCRIPTS/click-outside.applescript" | tee -a "$evidence/summary.txt"
  sleep 0.4
  if [[ "$(popup_is_open)" != "no" ]]; then
    fail "click outside did not close the popup"
  fi
  note "popup-click-outside closed"
  quit_focused
}

recipe_popup_layout() {
  use_fake_core
  focused_launch
  open_popup
  sleep 0.4
  osascript_run "$SCRIPTS/layout-frames.applescript" >"$evidence/frames.txt"
  dump_ax "$evidence/ax.txt"
  assert_ax layout "$evidence/frames.txt" "$evidence/ax.txt" || fail "popup layout did not match"
  shoot "$evidence/popup.png"
  note "popup-layout 560 wide, upper third, 40 pt mascot on the left"
  quit_focused
}

recipe_popup_input() {
  use_fake_core
  export COOKIE_DRIVE_KEYS=1
  unset COOKIE_FAKE_DELTA_MS
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_FAKE" 40; then
    fail "menu did not show $STATUS_UP_FAKE"
  fi
  open_popup
  dump_ax "$evidence/ax-open.txt"
  assert_ax field-label "$evidence/ax-open.txt" "Ask Cookie…" || fail "field label was not Ask Cookie…"
  set_field "alpha"
  sleep 0.2
  press_action "Shift Return"
  sleep 0.2
  dump_ax "$evidence/ax-newline.txt"
  assert_ax input-equals "$evidence/ax-newline.txt" 'alpha\n' forbid-you || fail "Shift-Return did not insert a newline"
  local press
  for press in 1 2 3; do
    press_action "Shift Return"
    sleep 0.15
  done
  dump_ax "$evidence/ax-five.txt"
  press_action "Shift Return"
  sleep 0.2
  dump_ax "$evidence/ax-capped.txt"
  assert_ax line-cap "$evidence/ax-five.txt" "$evidence/ax-capped.txt" || fail "Shift-Return did not stop at 5 lines"
  press_action "Clear Field"
  sleep 0.2
  dump_ax "$evidence/ax-cleared.txt"
  assert_ax input-equals "$evidence/ax-cleared.txt" "" allow || fail "⌘K did not clear the field"
  set_field "hello from popup-input"
  sleep 0.2
  osascript_run "$SCRIPTS/popup-action.applescript" confirm
  if ! wait_cookie_turn "$evidence/ax-sent.txt" 30; then
    fail "Return did not produce a cookie turn"
  fi
  assert_ax you-turn "$evidence/ax-sent.txt" "hello from popup-input" || fail "Return did not send the you turn"
  press_action "Recall Last"
  sleep 0.3
  dump_ax "$evidence/ax-recall.txt"
  assert_ax recall "$evidence/ax-recall.txt" "hello from popup-input" || fail "Up did not recall the last you text"
  shoot "$evidence/popup.png"
  note "popup-input label, Shift-Return, ⌘K, Return, Up"
  quit_focused
}

wait_cookie_turn() {
  local dest="$1"
  local tries="$2"
  local attempt
  for attempt in $(seq 1 "$tries"); do
    if osascript_run "$SCRIPTS/popup-dump.applescript" >"$dest"; then
      if grep -F $'cookie.turn.cookie.0\t' "$dest" >/dev/null; then
        return 0
      fi
    fi
    sleep 0.25
  done
  return 1
}

recipe_popup_draft() {
  use_fake_core
  unset COOKIE_DRAFT_TTL_SECONDS
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_FAKE" 40; then
    fail "menu did not show $STATUS_UP_FAKE"
  fi
  open_popup
  set_field "keep me"
  sleep 0.3
  osascript_run "$SCRIPTS/popup-action.applescript" cancel
  sleep 0.4
  if [[ "$(popup_is_open)" != "no" ]]; then
    fail "closing the popup for the draft failed"
  fi
  open_popup
  dump_ax "$evidence/ax-kept.txt"
  assert_ax input-equals "$evidence/ax-kept.txt" "keep me" allow || fail "draft was not kept across close and open"
  note "draft kept across close and open"
  quit_focused
  export COOKIE_DRAFT_TTL_SECONDS=2
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_FAKE" 40; then
    fail "menu did not show $STATUS_UP_FAKE after relaunch"
  fi
  open_popup
  set_field "expires"
  sleep 0.3
  osascript_run "$SCRIPTS/popup-action.applescript" cancel
  sleep 0.4
  if [[ "$(popup_is_open)" != "no" ]]; then
    fail "popup stayed open while the draft ttl ran"
  fi
  sleep 3
  open_popup
  dump_ax "$evidence/ax-expired.txt"
  assert_ax input-equals "$evidence/ax-expired.txt" "" allow || fail "draft was not cleared after the ttl"
  note "draft cleared after COOKIE_DRAFT_TTL_SECONDS=2 (product default remains 600)"
  quit_focused
}

recipe_popup_stream() {
  local kind="$1"
  use_fake_core
  export COOKIE_FAKE_DELTA_MS=2000
  unset COOKIE_DRIVE_KEYS
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_FAKE" 40; then
    fail "menu did not show $STATUS_UP_FAKE"
  fi
  open_popup
  set_field "hello from drive-mac"
  sleep 0.2
  osascript_run "$SCRIPTS/popup-action.applescript" confirm
  : >"$evidence/samples.txt"
  local attempt shot_prefix=0 state
  for attempt in $(seq 1 50); do
    menu_label >"$evidence/label.txt" || true
    osascript_run "$SCRIPTS/popup-dump.applescript" >"$evidence/ax.txt" || true
    state="$(assert_ax sample-line "$evidence/label.txt" "$evidence/ax.txt" "$FAKE_REPLY")"
    printf '%s\n' "$state" >>"$evidence/samples.txt"
    case "$state" in
      prefix*)
        if [[ "$shot_prefix" == "0" ]]; then
          shoot "$evidence/thinking.png"
          shot_prefix=1
        fi
        ;;
      full*)
        shoot "$evidence/popup.png"
        break
        ;;
    esac
    sleep 0.25
  done
  case "$kind" in
    thinking) assert_menu_thinking ;;
    talking) assert_talking_pose ;;
    reply) assert_popup_reply ;;
  esac
  quit_focused
}

assert_menu_thinking() {
  assert_ax thinking "$evidence/samples.txt" || fail "menu-thinking did not show Cookie, thinking then Cookie, listening"
  if [[ ! -s "$evidence/thinking.png" || ! -s "$evidence/popup.png" ]]; then
    fail "thinking screenshots were not written"
  fi
  note "menu-thinking Cookie, thinking then Cookie, listening"
}

assert_talking_pose() {
  osascript_run "$SCRIPTS/reduce-motion.applescript" >"$evidence/reduce-motion.txt" || true
  local reduce="unknown"
  if [[ -f "$evidence/reduce-motion.txt" ]]; then
    reduce="$(tr -d '[:space:]' <"$evidence/reduce-motion.txt")"
  fi
  assert_ax talking "$evidence/samples.txt" "$reduce" || fail "chat-talking-pose did not stay Cookie, talking"
  note "chat-talking-pose Cookie, talking while chunks arrive (reduce motion $(cat "$evidence/reduce-motion.txt" 2>/dev/null || true))"
}

assert_popup_reply() {
  assert_ax reply "$evidence/samples.txt" "$FAKE_REPLY" || fail "chat-popup-reply did not show chunks, you, and on-device"
  if [[ ! -s "$evidence/popup.png" ]]; then
    fail "popup screenshot was not written"
  fi
  cp "$evidence/samples.txt" "$evidence/chat.txt"
  note "chat-popup-reply chunks, you, on-device"
}

recipe_menu_thinking() {
  recipe_popup_stream thinking
}

recipe_chat_talking_pose() {
  recipe_popup_stream talking
}

recipe_chat_popup_reply() {
  recipe_popup_stream reply
}

recipe_status_loading() {
  require_port_free
  install_fault_wrapper loading
  focused_launch
  local attempt label count
  for attempt in $(seq 1 60); do
    label="$(menu_label || true)"
    printf '%s\n' "$label" >"$evidence/label.txt"
    read_menu >"$evidence/menu.txt" 2>"$evidence/menu.err" || true
    count="$(spawn_count | tr -d '[:space:]')"
    if [[ "$label" == "Cookie, loading" ]] && grep -F "$STATUS_LOADING" "$evidence/menu.txt" >/dev/null && [[ "${count:-0}" -ge 1 ]]; then
      if [[ -f "$COOKIE_DATA_DIR/logs/llama-server.log" ]] && grep -F "llama-fault-stub loading" "$COOKIE_DATA_DIR/logs/llama-server.log" >/dev/null; then
        break
      fi
    fi
    label=""
    sleep 0.5
  done
  if [[ "$label" != "Cookie, loading" ]]; then
    fail "loading glyph did not stay up (label ${label:-empty})"
  fi
  shoot "$evidence/loading-menu.png"
  open_popup
  set_field "still drafting"
  sleep 0.2
  osascript_run "$SCRIPTS/popup-action.applescript" confirm || true
  sleep 0.4
  dump_ax "$evidence/ax.txt"
  assert_ax loading "$evidence/ax.txt" "$LOADING_LINE" "still drafting" || fail "loading popup did not match"
  shoot "$evidence/popup.png"
  note "status-loading Cookie, loading; Send disabled; Loading the model…"
  quit_focused
  assert_fault_stub_gone
}

recipe_status_down() {
  require_port_free
  install_fault_wrapper down
  focused_launch
  local attempt label count=0
  for attempt in $(seq 1 70); do
    label="$(menu_label || true)"
    printf '%s\n' "$label" >"$evidence/label.txt"
    read_menu >"$evidence/menu.txt" 2>"$evidence/menu.err" || true
    count="$(spawn_count | tr -d '[:space:]')"
    if [[ "$label" == "Cookie, offline" ]] && grep -F "$STATUS_DOWN" "$evidence/menu.txt" >/dev/null && [[ "${count:-0}" -ge 3 ]]; then
      break
    fi
    label=""
    sleep 0.5
  done
  if [[ "$label" != "Cookie, offline" || "${count:-0}" -lt 3 ]]; then
    fail "down did not follow 3 failed restarts (label ${label:-empty}, spawns ${count:-0})"
  fi
  note "status-down after $count failed restarts"
  shoot "$evidence/offline-menu.png"
  open_popup
  set_field "offline draft"
  sleep 0.2
  osascript_run "$SCRIPTS/popup-action.applescript" confirm || true
  sleep 0.4
  dump_ax "$evidence/ax.txt"
  assert_ax down "$evidence/ax.txt" "$NOT_READY" "offline draft" || fail "down send started a reply"
  shoot "$evidence/popup.png"
  note "status-down Cookie, offline; draft kept; no cookie turn"
  quit_focused
  assert_fault_stub_gone
}

assert_fault_stub_gone() {
  local pid attempt
  pid="$(pid_file_pid || true)"
  for attempt in $(seq 1 20); do
    if [[ -z "$pid" ]] || ! pid_is_fault_stub "$pid"; then
      break
    fi
    sleep 0.25
    pid="$(pid_file_pid || true)"
  done
  if [[ -n "$pid" ]] && pid_is_fault_stub "$pid"; then
    fail "fault stub $pid still alive after quit"
  fi
  if port_listening 18080; then
    fail "port 18080 still listening after quit"
  fi
  note "fault stub reaped and port 18080 clear"
}

recipe_status_offline_chat() {
  unset COOKIE_CORE_COMMAND COOKIE_LLAMA_SERVER COOKIE_LLAMA_FAULT
  export COOKIE_LLAMA_PORT=18080
  start_up_stub
  export_blackhole_proxy
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_QWEN" 90; then
    fail "menu did not show $STATUS_UP_QWEN"
  fi
  if grep -E 'fake-local|starting model|model offline' "$evidence/menu.txt" >/dev/null; then
    fail "status line was not the on-device Qwen line"
  fi
  local label
  label="$(menu_label || true)"
  if [[ "$label" == "Cookie, offline" ]]; then
    fail "glyph was offline while the runtime was up"
  fi
  open_popup
  local attempt
  for attempt in 1 2 3; do
    set_field "hello from drive-mac"
    sleep 0.3
    osascript_run "$SCRIPTS/popup-action.applescript" confirm || true
    if wait_cookie_turn "$evidence/ax.txt" 20; then
      break
    fi
  done
  if ! grep -F $'cookie.turn.cookie.0\t' "$evidence/ax.txt" >/dev/null; then
    fail "offline chat did not finish a reply"
  fi
  assert_ax offline "$evidence/ax.txt" "$LOCAL_REPLY" || fail "offline reply was not the local on-device reply"
  shoot "$evidence/popup.png"
  cp "$evidence/ax.txt" "$evidence/chat.txt"
  if ! wait_menu_contains "$STATUS_UP_QWEN" 10; then
    fail "status line changed after the offline reply"
  fi
  if grep -F "$STATUS_DOWN" "$evidence/menu.txt" >/dev/null; then
    fail "status line became model offline"
  fi
  label="$(menu_label || true)"
  if [[ "$label" == "Cookie, offline" ]]; then
    fail "glyph became offline after the reply"
  fi
  printf '%s\n' "$label" >"$evidence/label-after.txt"
  assert_no_egress "$APP_PID"
  note "status-offline-chat on-device reply, status stayed $STATUS_UP_QWEN"
  quit_focused
  local pid="$STUB_PID"
  if ! kill -0 "$pid" 2>/dev/null; then
    fail "quit stopped the stub this app did not launch"
  fi
  note "unowned stub $STUB_PID still listening"
  stop_stub_pid "$STUB_PID"
  STUB_PID=""
  if port_listening 18080; then
    fail "port 18080 still listening after the recipe stopped its stub"
  fi
}

recipe_status_local_only() {
  use_fake_core
  focused_launch
  if ! wait_menu_contains "$STATUS_UP_FAKE" 40; then
    fail "up state did not show $STATUS_UP_FAKE"
  fi
  capture_mark "$evidence/mark-up.txt" "$evidence/menu-up.png"
  note "local-only checked while up"
  quit_focused

  require_port_free
  install_fault_wrapper loading
  focused_launch
  local attempt label count
  for attempt in $(seq 1 60); do
    label="$(menu_label || true)"
    read_menu >"$evidence/menu-loading.txt" 2>"$evidence/menu.err" || true
    if [[ "$label" == "Cookie, loading" ]] && grep -F "$STATUS_LOADING" "$evidence/menu-loading.txt" >/dev/null; then
      break
    fi
    label=""
    sleep 0.5
  done
  if [[ "$label" != "Cookie, loading" ]]; then
    fail "did not reach loading for the local-only check"
  fi
  capture_mark "$evidence/mark-loading.txt" "$evidence/menu-loading.png"
  note "local-only checked while loading"
  quit_focused
  assert_fault_stub_gone

  require_port_free
  install_fault_wrapper down
  focused_launch
  for attempt in $(seq 1 70); do
    label="$(menu_label || true)"
    read_menu >"$evidence/menu-down.txt" 2>"$evidence/menu.err" || true
    count="$(spawn_count | tr -d '[:space:]')"
    if [[ "$label" == "Cookie, offline" && "${count:-0}" -ge 3 ]] && grep -F "$STATUS_DOWN" "$evidence/menu-down.txt" >/dev/null; then
      break
    fi
    label=""
    sleep 0.5
  done
  if [[ "$label" != "Cookie, offline" ]]; then
    fail "did not reach down for the local-only check"
  fi
  capture_mark "$evidence/mark-down.txt" "$evidence/menu-down.png"
  note "local-only checked while down"
  quit_focused
  assert_fault_stub_gone
}

run_focused_recipe() {
  mkdir -p "$evidence"
  evidence="$(cd "$evidence" && pwd)"
  unset COOKIE_DRIVE_KEYS COOKIE_DRAFT_TTL_SECONDS COOKIE_FAKE_DELTA_MS
  write_command
  case "$feature" in
    menu-local-only) recipe_menu_local_only ;;
    menu-option-click) recipe_menu_option_click ;;
    menu-thinking) recipe_menu_thinking ;;
    popup-hotkey) recipe_popup_hotkey ;;
    popup-escape) recipe_popup_escape ;;
    popup-click-outside) recipe_popup_click_outside ;;
    popup-option-click) recipe_popup_option_click ;;
    popup-input) recipe_popup_input ;;
    popup-draft) recipe_popup_draft ;;
    popup-layout) recipe_popup_layout ;;
    chat-popup-reply) recipe_chat_popup_reply ;;
    chat-talking-pose) recipe_chat_talking_pose ;;
    status-loading) recipe_status_loading ;;
    status-down) recipe_status_down ;;
    status-offline-chat) recipe_status_offline_chat ;;
    status-local-only) recipe_status_local_only ;;
    *) fail "no recipe for $feature" ;;
  esac
  save_logs
  note "ok"
}
